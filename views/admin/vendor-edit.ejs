<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "vendors" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/admin/dashboard">Admin</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/admin/vendors">Vendors</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/admin/vendors/<%= vendor.id %>"><%= vendor.business_name %></a>
                <i class="bi bi-chevron-right"></i>
                <strong>Edit</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- PAGE HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Edit Vendor Store</h1>
                    <p class="text-muted mb-0 small">Update parameters, trade compliance, and commission rates for #<%= vendor.id %></p>
                </div>
                <div>
                    <a href="/admin/vendors/<%= vendor.id %>" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel & Return
                    </a>
                </div>
            </div>

            <!-- EDIT FORM -->
            <form action="/admin/vendors/<%= vendor.id %>/edit?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="row g-4">
                    <!-- SECTION 1: BUSINESS DETAILS -->
                    <div class="col-lg-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-card-header">
                                <span class="dashboard-card-title"><i class="bi bi-shop me-2 text-primary"></i>Shop & Location</span>
                            </div>
                            <div class="dashboard-card-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Shop / Business Name <span class="text-danger">*</span></label>
                                    <input type="text" name="business_name" class="form-control" required maxlength="200" value="<%= vendor.business_name %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Street Address <span class="text-danger">*</span></label>
                                    <textarea name="address" class="form-control" rows="2" required><%= vendor.address || '' %></textarea>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                                        <input type="text" name="city" class="form-control" required value="<%= vendor.city || '' %>">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">State <span class="text-danger">*</span></label>
                                        <input type="text" name="state" class="form-control" required value="<%= vendor.state || '' %>">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">Pincode <span class="text-danger">*</span></label>
                                        <input type="text" name="pincode" class="form-control" pattern="^[0-9]{6}$" maxlength="6" required value="<%= vendor.pincode || '' %>">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">License Number <span class="text-danger">*</span></label>
                                    <input type="text" name="license_number" class="form-control" required value="<%= vendor.license_number || '' %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Replace License Document (Optional)</label>
                                    <input type="file" name="license_doc" class="form-control" accept=".pdf,image/jpeg,image/png">
                                    <div class="form-text">
                                        <% if (vendor.license_document) { %>
                                            Current: <a href="<%= vendor.license_document %>" target="_blank">View File</a>. Leave blank to keep existing.
                                        <% } else { %>
                                            No document currently uploaded.
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: OWNER & CONFIGURATION -->
                    <div class="col-lg-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-card-header">
                                <span class="dashboard-card-title"><i class="bi bi-gear me-2 text-primary"></i>Account & Platform Settings</span>
                            </div>
                            <div class="dashboard-card-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Owner Full Name <span class="text-danger">*</span></label>
                                    <input type="text" name="owner_name" class="form-control" required maxlength="150" value="<%= vendor.owner_name %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Portal Username</label>
                                    <input type="text" class="form-control bg-light" value="@<%= vendor.username || 'unassigned' %>" readonly disabled>
                                    <div class="form-text">Usernames are immutable for security and audit trail integrity.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Contact Email <span class="text-danger">*</span></label>
                                    <input type="email" name="email" class="form-control" required value="<%= vendor.business_email || vendor.user_email %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">+91</span>
                                        <input type="tel" name="mobile" class="form-control" pattern="^[6-9][0-9]{9}$" maxlength="10" required value="<%= vendor.business_mobile || vendor.user_mobile %>">
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Commission Rate (%) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <input type="number" step="0.01" min="0" max="50" name="commission_rate" class="form-control" required value="<%= vendor.commission_rate %>">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Verification Status</label>
                                        <select name="verification_status" class="form-select">
                                            <option value="pending" <%= vendor.verification_status === 'pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="approved" <%= vendor.verification_status === 'approved' ? 'selected' : '' %>>Approved</option>
                                            <option value="rejected" <%= vendor.verification_status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                            <option value="suspended" <%= vendor.verification_status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Account State</label>
                                    <select name="status" class="form-select">
                                        <option value="active" <%= vendor.status === 'active' ? 'selected' : '' %>>Active</option>
                                        <option value="pending" <%= vendor.status === 'pending' ? 'selected' : '' %>>Pending Setup</option>
                                        <option value="inactive" <%= vendor.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                        <option value="suspended" <%= vendor.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                    </select>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/admin/vendors/<%= vendor.id %>" class="btn btn-outline-secondary">Cancel</a>
                                    <button type="submit" class="btn btn-primary" style="background-color: var(--primary); border-color: var(--primary);">
                                        <i class="bi bi-save me-1"></i> Update Vendor Profile
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
