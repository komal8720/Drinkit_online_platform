<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "vendor-add" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/admin/dashboard">Admin</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/admin/vendors">Vendors</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Add New Vendor</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- PAGE HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Register New Beverage Vendor</h1>
                    <p class="text-muted mb-0 small">Create a verified vendor profile and generate secure activation invitation</p>
                </div>
                <div>
                    <a href="/admin/vendors" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Vendors
                    </a>
                </div>
            </div>

            <!-- REGISTRATION FORM -->
            <form action="/admin/vendors/add?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="row g-4">
                    <!-- SECTION 1: SHOP & BUSINESS INFORMATION -->
                    <div class="col-lg-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-card-header">
                                <span class="dashboard-card-title"><i class="bi bi-shop me-2 text-primary"></i>Shop & Business Details</span>
                            </div>
                            <div class="dashboard-card-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Shop / Business Name <span class="text-danger">*</span></label>
                                    <input type="text" name="business_name" class="form-control" placeholder="e.g., Downtown Craft Beverages" required maxlength="200" value="<%= typeof form !== 'undefined' ? form.business_name || '' : '' %>">
                                    <div class="form-text">The official public name displayed to customers.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Shop Street Address <span class="text-danger">*</span></label>
                                    <textarea name="address" class="form-control" rows="2" placeholder="Street, Building, Unit / Landmark" required><%= typeof form !== 'undefined' ? form.address || '' : '' %></textarea>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                                        <input type="text" name="city" class="form-control" placeholder="City" required value="<%= typeof form !== 'undefined' ? form.city || '' : '' %>">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">State <span class="text-danger">*</span></label>
                                        <input type="text" name="state" class="form-control" placeholder="State" required value="<%= typeof form !== 'undefined' ? form.state || '' : '' %>">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">Pincode <span class="text-danger">*</span></label>
                                        <input type="text" name="pincode" class="form-control" placeholder="6 digits" pattern="^[0-9]{6}$" maxlength="6" required value="<%= typeof form !== 'undefined' ? form.pincode || '' : '' %>">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Trade / Liquor / FSSAI License Number <span class="text-danger">*</span></label>
                                    <input type="text" name="license_number" class="form-control" placeholder="e.g., FSSAI-12345678901234" required value="<%= typeof form !== 'undefined' ? form.license_number || '' : '' %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">License Document (PDF, JPG, PNG) <span class="text-danger">*</span></label>
                                    <input type="file" name="license_doc" class="form-control" accept=".pdf,image/jpeg,image/png" required>
                                    <div class="form-text">Max file size: 5MB. Verified before customer checkout enablement.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: OWNER & PORTAL CREDENTIALS -->
                    <div class="col-lg-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-card-header">
                                <span class="dashboard-card-title"><i class="bi bi-person-badge me-2 text-primary"></i>Owner & Account Credentials</span>
                            </div>
                            <div class="dashboard-card-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Owner Full Name <span class="text-danger">*</span></label>
                                    <input type="text" name="owner_name" class="form-control" placeholder="Full name of registered owner" required maxlength="150" value="<%= typeof form !== 'undefined' ? form.owner_name || '' : '' %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Portal Username <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">@</span>
                                        <input type="text" name="username" class="form-control" placeholder="unique_username" pattern="^[a-zA-Z0-9_]{3,30}$" required maxlength="30" value="<%= typeof form !== 'undefined' ? form.username || '' : '' %>">
                                    </div>
                                    <div class="form-text">3-30 characters, letters, numbers, and underscores only. Used for login.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" name="email" class="form-control" placeholder="vendor@example.com" required value="<%= typeof form !== 'undefined' ? form.email || '' : '' %>">
                                    <div class="form-text">The invitation link and order notifications will be sent to this email.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">+91</span>
                                        <input type="tel" name="mobile" class="form-control" placeholder="10-digit Indian number" pattern="^[6-9][0-9]{9}$" maxlength="10" required value="<%= typeof form !== 'undefined' ? form.mobile || '' : '' %>">
                                    </div>
                                    <div class="form-text">10 digits starting with 6, 7, 8, or 9.</div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Commission Rate (%) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <input type="number" step="0.01" min="0" max="50" name="commission_rate" class="form-control" value="<%= typeof form !== 'undefined' && form.commission_rate ? form.commission_rate : '10.00' %>" required>
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <div class="form-text">Platform fee percentage (0.00% - 50.00%).</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Initial Verification <span class="text-danger">*</span></label>
                                        <select name="verification_status" class="form-select">
                                            <option value="approved" selected>Approved</option>
                                            <option value="pending">Pending Review</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Initial Account Status <span class="text-danger">*</span></label>
                                    <select name="status" class="form-select">
                                        <option value="active" selected>Active</option>
                                        <option value="pending">Pending Setup</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                </div>

                                <div class="p-3 bg-light rounded-3 border mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="send_invitation" id="send_invitation" value="true" checked>
                                        <label class="form-check-label fw-semibold" for="send_invitation">
                                            Send Activation Invitation Email Immediately
                                        </label>
                                    </div>
                                    <p class="text-muted small mb-0 mt-1 ms-4">
                                        Sends a cryptographically secure 48-hour activation link so the vendor can set their password and log in.
                                    </p>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/admin/vendors" class="btn btn-outline-secondary">Cancel</a>
                                    <button type="submit" class="btn btn-primary" style="background-color: var(--primary); border-color: var(--primary);">
                                        <i class="bi bi-check2-circle me-1"></i> Create Vendor Store
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById("adminSidebar");
        const adminMain = document.getElementById("adminMain");
        const sidebarToggle = document.getElementById("sidebarToggle");

        const isCollapsed = localStorage.getItem("adminSidebarCollapsed") === "true";
        if (isCollapsed) {
            sidebar?.classList.add("collapsed");
            adminMain?.classList.add("expanded");
        }

        sidebarToggle?.addEventListener("click", () => {
            const collapsed = sidebar.classList.toggle("collapsed");
            adminMain.classList.toggle("expanded");
            localStorage.setItem("adminSidebarCollapsed", collapsed);
        });

        // Form validation
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
</body>

</html>
