<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "vendor-commissions" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/admin/dashboard">Admin</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/admin/vendors">Vendors</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Commissions & Payouts</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- PAGE HEADER -->
            <div class="mb-4">
                <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Vendor Commissions</h1>
                <p class="text-muted mb-0 small">Audit commission splits, payouts, and platform fee reconciliations</p>
            </div>

            <!-- KPI CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">GROSS ORDER VALUE</span>
                        <h3 class="fw-bold mb-0">₹<%= Number(summary.totalGross).toFixed(2) %></h3>
                        <span class="text-muted small"><%= summary.totalRecords %> transactions</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">PLATFORM REVENUE</span>
                        <h3 class="fw-bold mb-0 text-primary">₹<%= Number(summary.totalPlatformFee).toFixed(2) %></h3>
                        <span class="text-muted small">Retained platform fees</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">VENDOR PAYABLE</span>
                        <h3 class="fw-bold mb-0 text-success">₹<%= Number(summary.totalVendorAmount).toFixed(2) %></h3>
                        <span class="text-muted small">Gross minus platform commission</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">PENDING PAYOUTS</span>
                        <h3 class="fw-bold mb-0 text-warning">₹<%= Number(summary.pendingAmount).toFixed(2) %></h3>
                        <span class="text-muted small"><%= summary.pendingCount %> pending settlements</span>
                    </div>
                </div>
            </div>

            <!-- FILTERS -->
            <div class="dashboard-card mb-4">
                <div class="dashboard-card-body p-3">
                    <form method="GET" action="/admin/vendors/commissions" class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <input type="text" name="search" class="form-control" placeholder="Search order number or vendor shop name..." value="<%= search || '' %>">
                        </div>
                        <div class="col-md-4">
                            <select name="status" class="form-select">
                                <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Statuses</option>
                                <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="processed" <%= statusFilter === 'processed' ? 'selected' : '' %>>Processed</option>
                                <option value="paid" <%= statusFilter === 'paid' ? 'selected' : '' %>>Paid / Settled</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
                            <% if (search || statusFilter !== 'all') { %>
                                <a href="/admin/vendors/commissions" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- COMMISSIONS TABLE CARD -->
            <div class="dashboard-card">
                <div class="dashboard-card-body p-0">
                    <% if (commissions && commissions.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Ref / Date</th>
                                        <th>Vendor</th>
                                        <th>Order #</th>
                                        <th>Gross Amount</th>
                                        <th>Rate</th>
                                        <th>Commission Fee</th>
                                        <th>Vendor Net</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% commissions.forEach(c => { %>
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">#<%= c.id %></div>
                                                <span class="text-muted small"><%= new Date(c.created_at).toLocaleDateString("en-IN") %></span>
                                            </td>
                                            <td>
                                                <div class="fw-bold"><a href="/admin/vendors/<%= c.vendor_id %>" class="text-decoration-none text-dark"><%= c.business_name %></a></div>
                                                <span class="text-muted small"><%= c.owner_name %></span>
                                            </td>
                                            <td>
                                                <code><%= c.order_number %></code>
                                            </td>
                                            <td class="fw-semibold">₹<%= Number(c.order_amount).toFixed(2) %></td>
                                            <td><%= c.commission_percentage %>%</td>
                                            <td class="fw-semibold text-primary">₹<%= Number(c.commission_amount).toFixed(2) %></td>
                                            <td class="fw-bold text-success">₹<%= Number(c.vendor_amount).toFixed(2) %></td>
                                            <td>
                                                <% if (c.status === 'paid') { %>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Paid</span>
                                                <% } else if (c.status === 'processed') { %>
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Processed</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Pending</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <form action="/admin/vendors/commissions/<%= c.id %>/status" method="POST" class="d-inline-flex gap-1">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <select name="status" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                                                        <option value="pending" <%= c.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                        <option value="processed" <%= c.status === 'processed' ? 'selected' : '' %>>Processed</option>
                                                        <option value="paid" <%= c.status === 'paid' ? 'selected' : '' %>>Paid</option>
                                                    </select>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-percent display-5 d-block mb-3"></i>
                            No commission records found.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
