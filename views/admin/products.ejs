<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "products" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <%
        const defaultProductSvg = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40"><rect width="100%" height="100%" fill="%23F1F3F5"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="20" fill="%237A1535">📦</text></svg>';
        %>
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/admin/dashboard">Admin</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Products</strong>
            </div>

            <!-- PAGE HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Products</h1>
                    <p class="text-muted mb-0 small">Manage your catalog items, pricing, inventory, and status</p>
                </div>
                <a href="/admin/products/add" class="btn-primary-custom">
                    <i class="bi bi-plus-lg"></i> Add Product
                </a>
            </div>

            <!-- FILTERS BAR -->
            <form action="/admin/products" method="GET" class="filter-bar">
                <div class="form-group">
                    <label class="form-label">Search Products</label>
                    <input type="text" name="search" class="form-control" placeholder="Name, SKU..." value="<%= filters.search || '' %>">
                </div>

                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-control">
                        <option value="">All Categories</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>" <%= filters.category == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Stock Status</label>
                    <select name="stock" class="form-control">
                        <option value="">All Stock levels</option>
                        <option value="low" <%= filters.stock === 'low' ? 'selected' : '' %>>Low Stock (< 5)</option>
                        <option value="out" <%= filters.stock === 'out' ? 'selected' : '' %>>Out of Stock (0)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-control">
                        <option value="">All Statuses</option>
                        <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
                        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-custom" style="padding: 11px 18px;">
                        <i class="bi bi-filter"></i> Filter
                    </button>
                    <a href="/admin/products" class="btn-secondary-custom" style="padding: 11px 18px;">
                        Clear
                    </a>
                </div>
            </form>

            <!-- PRODUCTS TABLE CARD -->
            <div class="dashboard-card">
                <div class="dashboard-card-body p-0">
                    <% if (products && products.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>Brand</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% products.forEach(product => { %>
                                        <tr>
                                            <td>
                                                <div class="table-product-cell">
                                                    <img src="<%= product.image || defaultProductSvg %>" alt="<%= product.name %>" class="table-product-image" onerror="this.onerror=null; this.src='<%= defaultProductSvg %>'">
                                                    <div class="table-product-info">
                                                        <span class="table-product-name"><%= product.name %></span>
                                                        <span class="table-product-sku">SKU: <%= product.sku %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= product.category_name || 'N/A' %></td>
                                            <td><%= product.brand_name || 'N/A' %></td>
                                            <td class="fw-semibold">₹<%= product.price %></td>
                                            <td>
                                                <% if (product.stock_quantity === 0) { %>
                                                    <span class="text-danger fw-bold">Out of Stock</span>
                                                <% } else if (product.stock_quantity < 5) { %>
                                                    <span class="text-warning fw-semibold">Low Stock (<%= product.stock_quantity %>)</span>
                                                <% } else { %>
                                                    <span><%= product.stock_quantity %></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge <%= product.status %>"><%= product.status %></span>
                                            </td>
                                            <td>
                                                <div class="btn-action-group justify-content-end">
                                                    <a href="/admin/products/edit/<%= product.id %>" class="btn-action" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a href="/admin/products/delete/<%= product.id %>" class="btn-action delete" title="Delete" onclick="return confirm('Are you sure you want to delete this product?')">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state py-5">
                            <i class="bi bi-box"></i>
                            <p class="mb-0">No products found matching the criteria.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- SIDEBAR SCRIPT -->
    <script>
        const sidebar = document.getElementById("adminSidebar");
        const adminMain = document.getElementById("adminMain");
        const sidebarToggle = document.getElementById("sidebarToggle");

        const isCollapsed = localStorage.getItem("adminSidebarCollapsed") === "true";
        if (isCollapsed) {
            sidebar.classList.add("collapsed");
            adminMain.classList.add("expanded");
        }

        sidebarToggle?.addEventListener("click", () => {
            const collapsed = sidebar.classList.toggle("collapsed");
            adminMain.classList.toggle("expanded");
            localStorage.setItem("adminSidebarCollapsed", collapsed);
        });

        document.addEventListener("click", (event) => {
            if (
                window.innerWidth <= 991 &&
                sidebar.classList.contains("show") &&
                !sidebar.contains(event.target) &&
                !sidebarToggle.contains(event.target)
            ) {
                sidebar.classList.remove("show");
            }
        });

        sidebarToggle?.addEventListener("click", (e) => {
            if (window.innerWidth <= 991) {
                e.stopPropagation();
                sidebar.classList.add("show");
            }
        });
    </script>
</body>

</html>
