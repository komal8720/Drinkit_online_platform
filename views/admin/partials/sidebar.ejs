<aside class="admin-sidebar" id="adminSidebar">
    <!-- BRAND -->
    <div class="sidebar-brand" style="border-bottom: 1px solid var(--border-color);">
        <a href="/admin/dashboard">
            <div class="sidebar-brand-icon">
                <i class="bi bi-cup-straw"></i>
            </div>
            <div class="sidebar-brand-name">
                Drink<span>it</span>
            </div>
        </a>
    </div>

    <!-- MENU -->
    <nav class="sidebar-menu">
        <!-- OVERVIEW SECTION -->
        <div class="sidebar-section-title">
            Overview
        </div>
        <a href="/admin/dashboard" class="sidebar-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Dashboard</span>
        </a>

        <!-- CATALOG SECTION -->
        <div class="sidebar-section-title">
            Catalog
        </div>
        <a href="/admin/products" class="sidebar-link <%= currentPage === 'products' ? 'active' : '' %>">
            <i class="bi bi-box-seam"></i>
            <span>Products</span>
        </a>
        <a href="/admin/categories" class="sidebar-link <%= currentPage === 'categories' ? 'active' : '' %>">
            <i class="bi bi-tags"></i>
            <span>Categories</span>
        </a>

        <!-- ORDERS & CUSTOMERS SECTION -->
        <div class="sidebar-section-title">
            Orders & Customers
        </div>
        <a href="/admin/orders" class="sidebar-link <%= currentPage === 'orders' ? 'active' : '' %>">
            <i class="bi bi-bag-check"></i>
            <span>Orders</span>
        </a>
        <a href="/admin/customers" class="sidebar-link <%= currentPage === 'customers' ? 'active' : '' %>">
            <i class="bi bi-people"></i>
            <span>Customers</span>
        </a>

        <!-- BUSINESS SECTION -->
        <div class="sidebar-section-title">
            Business
        </div>
        <% const isVendorActive = typeof currentPage !== 'undefined' && currentPage && currentPage.startsWith('vendor'); %>
        <div class="sidebar-dropdown <%= isVendorActive ? 'open' : '' %>" id="vendorDropdown">
            <button type="button" class="sidebar-dropdown-toggle <%= isVendorActive ? 'active' : '' %>" onclick="document.getElementById('vendorDropdown').classList.toggle('open')">
                <i class="bi bi-shop"></i>
                <span>Vendors</span>
                <i class="bi bi-chevron-down chevron"></i>
            </button>
            <div class="sidebar-submenu">
                <a href="/admin/vendors" class="sidebar-link <%= currentPage === 'vendors' ? 'active' : '' %>">
                    <i class="bi bi-list-ul"></i>
                    <span>All Vendors</span>
                </a>
                <a href="/admin/vendors/add" class="sidebar-link <%= currentPage === 'vendor-add' ? 'active' : '' %>">
                    <i class="bi bi-plus-circle"></i>
                    <span>Add New Vendor</span>
                </a>
                <a href="/admin/vendors?verification_status=pending" class="sidebar-link <%= currentPage === 'vendor-verification' ? 'active' : '' %>">
                    <i class="bi bi-patch-check"></i>
                    <span>Vendor Verification</span>
                </a>
                <a href="/admin/vendors/commissions" class="sidebar-link <%= currentPage === 'vendor-commissions' ? 'active' : '' %>">
                    <i class="bi bi-percent"></i>
                    <span>Vendor Commission</span>
                </a>
                <a href="/admin/vendors/reports" class="sidebar-link <%= currentPage === 'vendor-reports' ? 'active' : '' %>">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Vendor Reports</span>
                </a>
            </div>
        </div>
        <a href="/admin/payments" class="sidebar-link <%= currentPage === 'payments' ? 'active' : '' %>">
            <i class="bi bi-credit-card"></i>
            <span>Payments</span>
        </a>
        <a href="/admin/reports" class="sidebar-link <%= currentPage === 'reports' ? 'active' : '' %>">
            <i class="bi bi-bar-chart-line"></i>
            <span>Reports & Analytics</span>
        </a>

        <!-- SYSTEM SECTION -->
        <div class="sidebar-section-title">
            System
        </div>
        <a href="/admin/settings" class="sidebar-link <%= currentPage === 'settings' ? 'active' : '' %>">
            <i class="bi bi-gear"></i>
            <span>Settings</span>
        </a>
        <a href="/admin/profile" class="sidebar-link <%= currentPage === 'profile' ? 'active' : '' %>">
            <i class="bi bi-person-circle"></i>
            <span>Admin Profile</span>
        </a>
        <a href="/admin/logout" class="sidebar-link">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>
    </nav>

    <!-- BOTTOM PROFILE -->
    <div class="sidebar-bottom">
        <div class="sidebar-admin-profile">
            <div class="admin-avatar">
                A
            </div>
            <div class="admin-info">
                <strong>Administrator</strong>
                <span>Super Admin</span>
            </div>
            <i class="bi bi-three-dots admin-profile-menu" id="adminProfileMenuBtn" title="Options"></i>
        </div>
    </div>
</aside>