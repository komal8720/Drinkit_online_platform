<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> - Drinkit Admin</title>


    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =====================================================
           ROOT
        ===================================================== */

        :root {

            --wine: #731b32;
            --wine-dark: #4f1021;
            --wine-light: #8d2945;

            --gold: #c9a45c;

            --dark: #171315;
            --muted: #777277;

            --border: #e9e4e5;

            --bg: #f7f5f4;
        }


        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {

            font-family: "Inter", sans-serif;

            background:
                radial-gradient(
                    circle at top left,
                    rgba(115, 27, 50, 0.08),
                    transparent 35%
                ),
                #f7f5f4;

            color: var(--dark);

            min-height: 100vh;

            overflow-x: hidden;
        }


        /* =====================================================
           MAIN LOGIN WRAPPER
        ===================================================== */

        .admin-login-wrapper {

            min-height: 100vh;

            width: 100%;

            display: flex;
        }


        /* =====================================================
           LEFT BRAND PANEL
        ===================================================== */

        .admin-brand-panel {

            width: 55%;

            min-height: 100vh;

            position: relative;

            overflow: hidden;

            display: flex;

            flex-direction: column;

            justify-content: space-between;

            padding: 55px 65px;

            color: #ffffff;

            background:

                linear-gradient(
                    135deg,
                    rgba(79, 16, 33, 0.97),
                    rgba(115, 27, 50, 0.88)
                ),

                url("/images/drinkit-hero.jpg")
                center / cover
                no-repeat;
        }


        /* decorative circles */

        .admin-brand-panel::before {

            content: "";

            position: absolute;

            width: 420px;
            height: 420px;

            border-radius: 50%;

            background: rgba(255, 255, 255, 0.035);

            top: -180px;
            right: -140px;
        }


        .admin-brand-panel::after {

            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            border-radius: 50%;

            background: rgba(255, 255, 255, 0.025);

            bottom: -150px;
            left: -100px;
        }


        /* =====================================================
           BRAND HEADER
        ===================================================== */

        .brand-header {

            position: relative;

            z-index: 2;

            display: flex;

            align-items: center;

            gap: 13px;
        }


        .brand-icon {

            width: 45px;
            height: 45px;

            border-radius: 13px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: rgba(255,255,255,0.13);

            border: 1px solid rgba(255,255,255,0.18);

            backdrop-filter: blur(10px);

            font-size: 21px;
        }


        .brand-name {

            font-size: 25px;

            font-weight: 800;

            letter-spacing: -0.7px;

            margin: 0;
        }


        .brand-name span {

            color: var(--gold);
        }


        /* =====================================================
           BRAND CONTENT
        ===================================================== */

        .brand-content {

            position: relative;

            z-index: 2;

            max-width: 650px;
        }


        .brand-label {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding: 8px 13px;

            border-radius: 30px;

            background: rgba(255,255,255,0.10);

            border: 1px solid rgba(255,255,255,0.15);

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 1.3px;

            color: rgba(255,255,255,0.9);

            margin-bottom: 22px;
        }


        .brand-label i {

            color: var(--gold);
        }


        .brand-title {

            font-size: clamp(38px, 4vw, 60px);

            line-height: 1.08;

            letter-spacing: -2px;

            font-weight: 800;

            margin-bottom: 20px;
        }


        .brand-title span {

            color: var(--gold);
        }


        .brand-description {

            max-width: 570px;

            color: rgba(255,255,255,0.72);

            line-height: 1.8;

            font-size: 14px;

            margin-bottom: 35px;
        }


        /* =====================================================
           FEATURES
        ===================================================== */

        .brand-features {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 13px;
        }


        .feature-box {

            padding: 18px 15px;

            border-radius: 14px;

            background: rgba(255,255,255,0.075);

            border: 1px solid rgba(255,255,255,0.10);

            backdrop-filter: blur(10px);

            transition: 0.25s ease;
        }


        .feature-box:hover {

            transform: translateY(-3px);

            background: rgba(255,255,255,0.11);
        }


        .feature-icon {

            width: 35px;
            height: 35px;

            border-radius: 9px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: rgba(255,255,255,0.10);

            margin-bottom: 12px;

            color: var(--gold);
        }


        .feature-box strong {

            display: block;

            font-size: 12px;

            margin-bottom: 5px;
        }


        .feature-box span {

            display: block;

            font-size: 10px;

            line-height: 1.5;

            color: rgba(255,255,255,0.58);
        }


        /* =====================================================
           BRAND FOOTER
        ===================================================== */

        .brand-footer {

            position: relative;

            z-index: 2;

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding-top: 20px;

            border-top: 1px solid rgba(255,255,255,0.12);

            color: rgba(255,255,255,0.5);

            font-size: 11px;
        }


        .secure-badge {

            display: flex;

            align-items: center;

            gap: 7px;
        }


        .secure-badge i {

            color: #8fd694;
        }


        /* =====================================================
           RIGHT SIDE
        ===================================================== */

        .admin-form-panel {

            width: 45%;

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 35px;
        }


        /* =====================================================
           LOGIN CARD
        ===================================================== */

        .login-card {

            width: 100%;

            max-width: 390px;

            background: #ffffff;

            border: 1px solid var(--border);

            border-radius: 22px;

            padding: 34px;

            box-shadow:
                0 20px 50px rgba(38, 25, 29, 0.09);

            position: relative;
        }


        /* small top line */

        .login-card::before {

            content: "";

            position: absolute;

            top: 0;

            left: 35px;

            right: 35px;

            height: 3px;

            border-radius: 0 0 10px 10px;

            background:
                linear-gradient(
                    90deg,
                    var(--wine),
                    var(--gold)
                );
        }


        /* =====================================================
           LOGIN HEADER
        ===================================================== */

        .login-header {

            text-align: center;

            margin-bottom: 25px;
        }


        .login-icon {

            width: 55px;
            height: 55px;

            margin: 0 auto 15px;

            border-radius: 15px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--wine),
                    var(--wine-dark)
                );

            color: #ffffff;

            font-size: 22px;

            box-shadow:
                0 8px 20px
                rgba(115,27,50,0.20);
        }


        .login-header h2 {

            font-size: 22px;

            font-weight: 800;

            margin-bottom: 6px;

            letter-spacing: -0.5px;
        }


        .login-header p {

            margin: 0;

            color: var(--muted);

            font-size: 12px;

            line-height: 1.5;
        }


        /* =====================================================
           ERROR
        ===================================================== */

        .login-error {

            display: flex;

            align-items: center;

            gap: 9px;

            padding: 11px 13px;

            border-radius: 10px;

            margin-bottom: 18px;

            background: #fff1f1;

            color: #b42318;

            font-size: 11px;

            border: 1px solid #ffd8d8;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .form-group {

            margin-bottom: 17px;
        }


        .form-label {

            display: block;

            font-size: 11px;

            font-weight: 700;

            color: #4e494b;

            margin-bottom: 7px;
        }


        .input-wrapper {

            position: relative;
        }


        .input-icon {

            position: absolute;

            left: 13px;

            top: 50%;

            transform: translateY(-50%);

            color: #969093;

            font-size: 14px;

            z-index: 2;
        }


        .form-control {

            width: 100%;

            height: 45px;

            border: 1px solid #ddd8da;

            border-radius: 10px;

            padding:
                0 42px 0 38px;

            font-size: 12px;

            color: var(--dark);

            outline: none;

            transition: 0.2s ease;

            background: #ffffff;
        }


        .form-control::placeholder {

            color: #aaa5a7;
        }


        .form-control:focus {

            border-color: var(--wine);

            box-shadow:
                0 0 0 3px
                rgba(115,27,50,0.08);
        }


        /* password eye */

        .password-toggle {

            position: absolute;

            right: 12px;

            top: 50%;

            transform: translateY(-50%);

            border: none;

            background: transparent;

            color: #888286;

            cursor: pointer;

            padding: 4px;

            font-size: 14px;
        }


        .password-toggle:hover {

            color: var(--wine);
        }


        /* =====================================================
           LOGIN BUTTON
        ===================================================== */

        .login-btn {

            width: 100%;

            height: 45px;

            border: none;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    var(--wine),
                    var(--wine-dark)
                );

            color: #ffffff;

            font-size: 12px;

            font-weight: 700;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            cursor: pointer;

            transition: 0.25s ease;

            box-shadow:
                0 7px 18px
                rgba(115,27,50,0.18);
        }


        .login-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 10px 22px
                rgba(115,27,50,0.25);
        }


        .login-btn i {

            font-size: 14px;
        }


        /* =====================================================
           SECURE FOOTER
        ===================================================== */

        .login-footer {

            margin-top: 21px;

            padding-top: 17px;

            border-top: 1px solid #eeeeee;

            text-align: center;

            font-size: 10px;

            color: #999396;
        }


        .login-footer i {

            color: var(--wine);

            margin-right: 4px;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 1100px) {

            .admin-brand-panel {

                width: 52%;

                padding: 45px;
            }

            .admin-form-panel {

                width: 48%;
            }

            .brand-features {

                grid-template-columns: 1fr;
            }

            .feature-box {

                padding: 13px;
            }
        }


        @media (max-width: 850px) {

            .admin-login-wrapper {

                display: block;
            }

            .admin-brand-panel {

                display: none;
            }

            .admin-form-panel {

                width: 100%;

                min-height: 100vh;

                padding: 25px;
            }

            .login-card {

                max-width: 390px;
            }
        }


        @media (max-width: 480px) {

            .admin-form-panel {

                padding: 18px;
            }

            .login-card {

                padding: 28px 22px;

                border-radius: 18px;
            }

            .login-card::before {

                left: 25px;

                right: 25px;
            }
        }

    </style>

</head>


<body>


<div class="admin-login-wrapper">


    <!-- =====================================================
         LEFT BRAND PANEL
    ====================================================== -->

    <section class="admin-brand-panel">


        <!-- BRAND -->

        <div class="brand-header">

            <div class="brand-icon">

                <i class="bi bi-cup-straw"></i>

            </div>

            <h1 class="brand-name">
                Drink<span>it</span>
            </h1>

        </div>


        <!-- CONTENT -->

        <div class="brand-content">


            <div class="brand-label">

                <i class="bi bi-stars"></i>

                ADMIN MANAGEMENT PLATFORM

            </div>


            <h2 class="brand-title">

                Manage your
                <span>beverage business</span>
                with confidence.

            </h2>


            <p class="brand-description">

                A centralized administration platform to manage
                products, orders, customers, vendors, inventory
                and business performance from one secure workspace.

            </p>


            <!-- FEATURES -->

            <div class="brand-features">


                <div class="feature-box">

                    <div class="feature-icon">

                        <i class="bi bi-shield-check"></i>

                    </div>

                    <strong>
                        Secure Access
                    </strong>

                    <span>
                        Protected admin
                        authentication.
                    </span>

                </div>


                <div class="feature-box">

                    <div class="feature-icon">

                        <i class="bi bi-bar-chart-line"></i>

                    </div>
\+
                    <strong>
                        Smart Analytics
                    </strong>

                    <span>
                        Monitor business
                        performance.
                    </span>

                </div>


                <div class="feature-box">

                    <div class="feature-icon">

                        <i class="bi bi-box-seam"></i>

                    </div>

                    <strong>
                        Order Control
                    </strong>

                    <span>
                        Manage products
                        and orders easily.
                    </span>

                </div>


            </div>

        </div>


        <!-- FOOTER -->

        <div class="brand-footer">

            <span>
                © <%= new Date().getFullYear() %> Drinkit
            </span>

            <span class="secure-badge">

                <i class="bi bi-lock-fill"></i>

                Secure Administrator Access

            </span>

        </div>


    </section>



    <!-- =====================================================
         RIGHT LOGIN PANEL
    ====================================================== -->

    <section class="admin-form-panel">


        <div class="login-card">


            <!-- HEADER -->

            <div class="login-header">

                <div class="login-icon">

                    <i class="bi bi-person-lock"></i>

                </div>


                <h2>
                    Welcome Back
                </h2>


                <p>
                    Sign in to access your
                    Drinkit admin dashboard.
                </p>

            </div>



            <!-- ERROR -->

            <% if (typeof error !== 'undefined' && error) { %>

                <div class="login-error">

                    <i class="bi bi-exclamation-circle-fill"></i>

                    <span>
                        <%= error %>
                    </span>

                </div>

            <% } %>



            <!-- LOGIN FORM -->

            <form
                action="/admin/login"
                method="POST"
            >
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : (locals.csrfToken || '') %>">


                <!-- EMAIL -->

                <div class="form-group">

                    <label
                        for="email"
                        class="form-label"
                    >
                        Email Address
                    </label>


                    <div class="input-wrapper">

                        <i class="bi bi-envelope input-icon"></i>


                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="admin@drinkit.com"
                            autocomplete="email"
                            required
                        >

                    </div>

                </div>



                <!-- PASSWORD -->

                <div class="form-group">

                    <label
                        for="password"
                        class="form-label"
                    >
                        Password
                    </label>


                    <div class="input-wrapper">

                        <i class="bi bi-lock input-icon"></i>


                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >


                        <button
                            type="button"
                            class="password-toggle"
                            id="togglePassword"
                            aria-label="Show password"
                        >

                            <i
                                class="bi bi-eye"
                                id="togglePasswordIcon"
                            ></i>

                        </button>

                    </div>

                </div>



                <!-- LOGIN BUTTON -->

                <button
                    type="submit"
                    class="login-btn"
                >

                    <span>
                        Login to Dashboard
                    </span>

                    <i class="bi bi-arrow-right"></i>

                </button>


            </form>



            <!-- FOOTER -->

            <div class="login-footer">

                <i class="bi bi-shield-lock-fill"></i>

                Authorized administrator access only

            </div>


        </div>


    </section>


</div>



<!-- =====================================================
     PASSWORD TOGGLE
====================================================== -->

<script>

    const togglePassword =
        document.getElementById("togglePassword");

    const passwordInput =
        document.getElementById("password");

    const togglePasswordIcon =
        document.getElementById("togglePasswordIcon");


    if (
        togglePassword &&
        passwordInput &&
        togglePasswordIcon
    ) {

        togglePassword.addEventListener(
            "click",
            function () {

                const isPassword =
                    passwordInput.type === "password";


                passwordInput.type =
                    isPassword
                        ? "text"
                        : "password";


                if (isPassword) {

                    togglePasswordIcon.classList.remove(
                        "bi-eye"
                    );

                    togglePasswordIcon.classList.add(
                        "bi-eye-slash"
                    );

                    togglePassword.setAttribute(
                        "aria-label",
                        "Hide password"
                    );

                } else {

                    togglePasswordIcon.classList.remove(
                        "bi-eye-slash"
                    );

                    togglePasswordIcon.classList.add(
                        "bi-eye"
                    );

                    togglePassword.setAttribute(
                        "aria-label",
                        "Show password"
                    );

                }

            }
        );

    }

</script>


</body>

</html>