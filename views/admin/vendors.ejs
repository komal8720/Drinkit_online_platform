<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "vendors" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/admin/dashboard">Admin</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Vendors</strong>
            </div>

            <!-- PAGE HEADER -->
            <div class="mb-4">
                <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Vendors</h1>
                <p class="text-muted mb-0 small">Approve and verify beverage shops, vendor details, and trade licenses</p>
            </div>

            <!-- VENDORS TABLE CARD -->
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <span class="dashboard-card-title">Beverage Shop Vendors</span>
                </div>
                <div class="dashboard-card-body p-0">
                    <% if (vendors && vendors.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Shop / Business</th>
                                        <th>Owner Name</th>
                                        <th>Contact</th>
                                        <th>License Number</th>
                                        <th>Verification Status</th>
                                        <th class="text-end">Verification Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% vendors.forEach(v => { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="sidebar-brand-icon" style="background-color: var(--primary-light); color: var(--primary); box-shadow: none;">
                                                        <i class="bi bi-shop"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold"><%= v.business_name %></div>
                                                        <span class="text-muted small">ID: #<%= v.id %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= v.owner_name %></td>
                                            <td>
                                                <div><%= v.email %></div>
                                                <% if (v.mobile) { %>
                                                    <div class="text-muted small mt-1"><i class="bi bi-phone me-1"></i><%= v.mobile %></div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <code><%= v.license_number || 'N/A' %></code>
                                            </td>
                                            <td>
                                                <span class="badge <%= v.verification_status %>"><%= v.verification_status %></span>
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-end">
                                                    <form action="/admin/vendors/<%= v.id %>/verify" method="POST" class="d-inline-flex gap-2">
                                                        <select name="status" class="form-control form-control-sm" style="width: auto; padding: 4px 10px; font-size: 0.8rem; border-radius: var(--radius-sm);" onchange="this.form.submit()">
                                                            <option value="pending" <%= v.verification_status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                            <option value="approved" <%= v.verification_status === 'approved' ? 'selected' : '' %>>Approved</option>
                                                            <option value="rejected" <%= v.verification_status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                                            <option value="suspended" <%= v.verification_status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                                        </select>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state py-5">
                            <i class="bi bi-shop"></i>
                            <p class="mb-0">No beverage vendors found in the database.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- SIDEBAR SCRIPT -->
    <script>
        const sidebar = document.getElementById("adminSidebar");
        const adminMain = document.getElementById("adminMain");
        const sidebarToggle = document.getElementById("sidebarToggle");

        const isCollapsed = localStorage.getItem("adminSidebarCollapsed") === "true";
        if (isCollapsed) {
            sidebar.classList.add("collapsed");
            adminMain.classList.add("expanded");
        }

        sidebarToggle?.addEventListener("click", () => {
            const collapsed = sidebar.classList.toggle("collapsed");
            adminMain.classList.toggle("expanded");
            localStorage.setItem("adminSidebarCollapsed", collapsed);
        });
    </script>
</body>

</html>
