<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "vendors" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/admin/dashboard">Admin</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/admin/vendors">Vendors</a>
                <i class="bi bi-chevron-right"></i>
                <strong><%= vendor.business_name %></strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- HEADER ACTIONS -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="sidebar-brand-icon" style="background-color: var(--primary-light); color: var(--primary); box-shadow: none; width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-shop"></i>
                    </div>
                    <div>
                        <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;"><%= vendor.business_name %></h1>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <span>Vendor ID: #<%= vendor.id %></span>
                            &bull;
                            <span>User: @<%= vendor.username || 'unassigned' %></span>
                            &bull;
                            <% if (vendor.verification_status === 'approved') { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                            <% } else { %>
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><%= vendor.verification_status %></span>
                            <% } %>
                            <% if (vendor.status === 'active') { %>
                                <span class="badge bg-success text-white">Active</span>
                            <% } else { %>
                                <span class="badge bg-secondary text-white"><%= vendor.status %></span>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/admin/vendors/<%= vendor.id %>/edit" class="btn btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Edit Profile
                    </a>
                    <form action="/admin/vendors/<%= vendor.id %>/resend-invitation" method="POST" class="d-inline" onsubmit="return confirm('Send fresh activation link to <%= vendor.business_email || vendor.user_email %>?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-warning">
                            <i class="bi bi-envelope me-1"></i> Resend Invite
                        </button>
                    </form>
                    <a href="/admin/vendors" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>

            <!-- METRIC CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">TOTAL PRODUCTS</span>
                            <i class="bi bi-box-seam text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0"><%= stats.totalProducts %></h3>
                        <span class="text-muted small"><%= stats.activeProducts %> currently active</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">TOTAL ORDERS</span>
                            <i class="bi bi-bag-check text-info fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0"><%= stats.totalOrders %></h3>
                        <span class="text-muted small"><%= stats.completedOrders %> delivered</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">GROSS SALES</span>
                            <i class="bi bi-currency-rupee text-success fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-success">₹<%= Number(stats.grossSales).toFixed(2) %></h3>
                        <span class="text-muted small">Total item revenue</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">PLATFORM COMMISSION</span>
                            <i class="bi bi-percent text-danger fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-danger">₹<%= Number(stats.totalCommission).toFixed(2) %></h3>
                        <span class="text-muted small">Rate: <%= vendor.commission_rate %>%</span>
                    </div>
                </div>
            </div>

            <!-- DETAILS ROW -->
            <div class="row g-4 mb-4">
                <!-- VENDOR INFO CARD -->
                <div class="col-lg-6">
                    <div class="dashboard-card h-100">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title"><i class="bi bi-building me-2 text-primary"></i>Store Profile & Compliance</span>
                        </div>
                        <div class="dashboard-card-body p-4">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">Owner Full Name</label>
                                    <span class="fw-semibold"><%= vendor.owner_name %></span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">Portal Login Username</label>
                                    <code>@<%= vendor.username || 'unassigned' %></code>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">Business Email</label>
                                    <span><i class="bi bi-envelope me-1 text-muted"></i><%= vendor.business_email || vendor.user_email %></span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">Business Mobile</label>
                                    <span><i class="bi bi-phone me-1 text-muted"></i><%= vendor.business_mobile || vendor.user_mobile %></span>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small d-block">Store Address</label>
                                    <span><%= vendor.address || 'No street address specified' %></span>
                                    <div class="text-muted small"><%= vendor.city ? (vendor.city + ', ' + (vendor.state || '') + ' - ' + (vendor.pincode || '')) : '' %></div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">License Number</label>
                                    <code><%= vendor.license_number || 'N/A' %></code>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">License Certificate</label>
                                    <% if (vendor.license_document) { %>
                                        <a href="<%= vendor.license_document %>" target="_blank" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-file-earmark-arrow-down me-1"></i> View License Document
                                        </a>
                                    <% } else { %>
                                        <span class="text-muted">No document uploaded</span>
                                    <% } %>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">Registered Date</label>
                                    <span><%= new Date(vendor.created_at).toLocaleDateString("en-IN", { dateStyle: 'long' }) %></span>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small d-block">Approval Timestamp</label>
                                    <span><%= vendor.approved_at ? new Date(vendor.approved_at).toLocaleString("en-IN", { dateStyle: 'medium', timeStyle: 'short' }) : 'Pending / Not stamped' %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CONTROLS CARD -->
                <div class="col-lg-6">
                    <div class="dashboard-card h-100">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title"><i class="bi bi-sliders me-2 text-primary"></i>Administrative Actions & Auditing</span>
                        </div>
                        <div class="dashboard-card-body p-4">
                            <!-- VERIFICATION FORM -->
                            <form action="/admin/vendors/<%= vendor.id %>/verify" method="POST" class="mb-4 pb-3 border-bottom">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <label class="form-label fw-semibold">Update Verification Status</label>
                                <div class="input-group">
                                    <select name="status" class="form-select">
                                        <option value="pending" <%= vendor.verification_status === 'pending' ? 'selected' : '' %>>Pending Review</option>
                                        <option value="approved" <%= vendor.verification_status === 'approved' ? 'selected' : '' %>>Approved</option>
                                        <option value="rejected" <%= vendor.verification_status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                        <option value="suspended" <%= vendor.verification_status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary">Save Verification</button>
                                </div>
                                <div class="form-text">Changing to Approved enables store products in customer search.</div>
                            </form>

                            <!-- ACCOUNT STATUS FORM -->
                            <form action="/admin/vendors/<%= vendor.id %>/status" method="POST" class="mb-3">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <label class="form-label fw-semibold">Account State</label>
                                <div class="input-group">
                                    <select name="status" class="form-select">
                                        <option value="active" <%= vendor.status === 'active' ? 'selected' : '' %>>Active</option>
                                        <option value="pending" <%= vendor.status === 'pending' ? 'selected' : '' %>>Pending Setup</option>
                                        <option value="inactive" <%= vendor.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                        <option value="suspended" <%= vendor.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                    </select>
                                    <button type="submit" class="btn btn-outline-dark">Update State</button>
                                </div>
                                <div class="form-text">Suspended vendors cannot log into their vendor dashboard.</div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RECENT PRODUCTS TABLE -->
            <div class="dashboard-card mb-4">
                <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                    <span class="dashboard-card-title">Recent Store Products</span>
                </div>
                <div class="dashboard-card-body p-0">
                    <% if (recentProducts && recentProducts.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentProducts.forEach(p => { %>
                                        <tr>
                                            <td class="fw-semibold"><%= p.name %></td>
                                            <td><%= p.category_name || 'N/A' %></td>
                                            <td>₹<%= Number(p.price).toFixed(2) %></td>
                                            <td><%= p.stock_quantity %> units</td>
                                            <td><span class="badge <%= p.status %>"><%= p.status %></span></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-4 text-center text-muted">No products listed by this vendor yet.</div>
                    <% } %>
                </div>
            </div>

            <!-- RECENT ORDERS TABLE -->
            <div class="dashboard-card">
                <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                    <span class="dashboard-card-title">Recent Vendor Orders</span>
                </div>
                <div class="dashboard-card-body p-0">
                    <% if (recentOrders && recentOrders.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Placed On</th>
                                        <th>Vendor Items Total</th>
                                        <th>Order Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentOrders.forEach(o => { %>
                                        <tr>
                                            <td class="fw-semibold"><%= o.order_number %></td>
                                            <td><%= new Date(o.created_at).toLocaleString("en-IN", { dateStyle: 'medium', timeStyle: 'short' }) %></td>
                                            <td class="fw-bold text-success">₹<%= Number(o.vendor_total).toFixed(2) %></td>
                                            <td><span class="badge <%= o.order_status %>"><%= o.order_status %></span></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-4 text-center text-muted">No orders placed for this vendor yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
