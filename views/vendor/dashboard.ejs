<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "dashboard" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Dashboard</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- STORE WELCOME BANNER -->
            <div class="dashboard-card mb-4 p-4 text-white" style="background: linear-gradient(135deg, var(--primary) 0%, #5E0D25 100%); border: none;">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <span class="badge bg-white text-dark mb-2 px-2 py-1">Store Dashboard</span>
                        <h2 class="fw-bold mb-1"><%= currentVendor.business_name %></h2>
                        <p class="mb-0 text-white-50 small">Welcome back, <%= currentVendor.owner_name %>! Here is your real-time store performance summary.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/vendor/products/add" class="btn btn-light fw-semibold">
                            <i class="bi bi-plus-circle me-1 text-primary"></i> Add Product
                        </a>
                        <a href="/vendor/orders" class="btn btn-outline-light">
                            <i class="bi bi-bag-check me-1"></i> View Orders
                        </a>
                    </div>
                </div>
            </div>

            <!-- KPI METRIC CARDS (ZERO MOCK RULE: LIVE SQL DATA) -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">TOTAL PRODUCTS</span>
                            <i class="bi bi-box-seam text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0"><%= stats.totalProducts %></h3>
                        <span class="text-muted small"><%= stats.activeProducts %> active in catalog</span>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">PENDING ORDERS</span>
                            <i class="bi bi-clock-history text-warning fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-warning"><%= stats.pendingOrders %></h3>
                        <span class="text-muted small">Requiring preparation / pickup</span>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">GROSS REVENUE</span>
                            <i class="bi bi-currency-rupee text-success fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-success">₹<%= Number(stats.grossRevenue).toFixed(2) %></h3>
                        <span class="text-muted small"><%= stats.completedOrders %> delivered orders</span>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold">NET STORE PAYOUT</span>
                            <i class="bi bi-cash-coin text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-primary">₹<%= Number(stats.netRevenue).toFixed(2) %></h3>
                        <span class="text-muted small">Commission rate: <%= currentVendor.commission_rate %>%</span>
                    </div>
                </div>
            </div>

            <!-- LOW STOCK ALERTS & QUICK ACTIONS -->
            <% if (lowStockProducts && lowStockProducts.length > 0) { %>
                <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                        <div>
                            <strong>Low Stock Inventory Alert!</strong>
                            <div class="small"><%= lowStockProducts.length %> beverage items have 5 or fewer units in stock.</div>
                        </div>
                    </div>
                    <a href="/vendor/products" class="btn btn-sm btn-warning fw-semibold">Manage Inventory</a>
                </div>
            <% } %>

            <!-- RECENT ORDERS TABLE -->
            <div class="dashboard-card mb-4">
                <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                    <span class="dashboard-card-title">Recent Store Orders</span>
                    <a href="/vendor/orders" class="btn btn-sm btn-outline-primary">View All Orders</a>
                </div>
                <div class="dashboard-card-body p-0">
                    <% if (recentOrders && recentOrders.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date &amp; Time</th>
                                        <th>Items Ordered</th>
                                        <th>Your Share (Total)</th>
                                        <th>Order Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentOrders.forEach(o => { %>
                                        <tr>
                                            <td class="fw-bold">
                                                <a href="/vendor/orders/<%= o.order_id %>" class="text-decoration-none text-dark"><%= o.order_number %></a>
                                            </td>
                                            <td class="text-muted small">
                                                <%= new Date(o.created_at).toLocaleString("en-IN", { dateStyle: 'medium', timeStyle: 'short' }) %>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-secondary border"><%= o.item_count %> items</span>
                                            </td>
                                            <td class="fw-bold text-success">
                                                ₹<%= Number(o.vendor_order_total).toFixed(2) %>
                                            </td>
                                            <td>
                                                <% if (o.order_status === 'delivered') { %>
                                                    <span class="badge bg-success text-white">Delivered</span>
                                                <% } else if (o.order_status === 'cancelled') { %>
                                                    <span class="badge bg-danger text-white">Cancelled</span>
                                                <% } else if (o.order_status === 'confirmed' || o.order_status === 'preparing') { %>
                                                    <span class="badge bg-info text-dark"><%= o.order_status %></span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark"><%= o.order_status %></span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <a href="/vendor/orders/<%= o.order_id %>" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-eye"></i> Details
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-bag-check display-5 d-block mb-3"></i>
                            No orders placed for your store yet.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById("vendorSidebar");
        const adminMain = document.getElementById("adminMain");
        const sidebarToggle = document.getElementById("sidebarToggle");

        const isCollapsed = localStorage.getItem("vendorSidebarCollapsed") === "true";
        if (isCollapsed) {
            sidebar?.classList.add("collapsed");
            adminMain?.classList.add("expanded");
        }

        sidebarToggle?.addEventListener("click", () => {
            const collapsed = sidebar.classList.toggle("collapsed");
            adminMain.classList.toggle("expanded");
            localStorage.setItem("vendorSidebarCollapsed", collapsed);
        });
    </script>
</body>

</html>
