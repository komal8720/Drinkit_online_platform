<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "profile" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Store Profile</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- HEADER -->
            <div class="mb-4">
                <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Store Settings &amp; Profile</h1>
                <p class="text-muted mb-0 small">Manage your business address, operational contact numbers, and compliance details</p>
            </div>

            <div class="row g-4">
                <!-- PROFILE OVERVIEW & COMPLIANCE -->
                <div class="col-lg-5">
                    <div class="dashboard-card mb-4">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title">Store Verification Badge</span>
                        </div>
                        <div class="dashboard-card-body p-4 text-center">
                            <div class="sidebar-brand-icon mx-auto mb-3" style="background-color: var(--primary-light); color: var(--primary); width: 64px; height: 64px; font-size: 2rem; border-radius: 16px;">
                                <i class="bi bi-shop"></i>
                            </div>
                            <h4 class="fw-bold mb-1"><%= currentVendor.business_name %></h4>
                            <p class="text-muted small mb-3">Owner: <%= currentVendor.owner_name %></p>

                            <div class="d-flex justify-content-center gap-2 mb-3">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                    <i class="bi bi-patch-check-fill me-1"></i> Verification: <%= currentVendor.verification_status %>
                                </span>
                                <span class="badge bg-light text-dark border px-3 py-2">
                                    Commission: <%= currentVendor.commission_rate %>%
                                </span>
                            </div>

                            <div class="p-3 bg-light rounded text-start small">
                                <div class="mb-2"><strong>Vendor ID:</strong> #<%= currentVendor.id %></div>
                                <div class="mb-2"><strong>Portal Username:</strong> @<%= currentUser.username %></div>
                                <div class="mb-2"><strong>License Number:</strong> <code><%= currentVendor.license_number || 'N/A' %></code></div>
                                <div>
                                    <strong>Trade License Doc:</strong>
                                    <% if (currentVendor.license_document) { %>
                                        <a href="<%= currentVendor.license_document %>" target="_blank" class="ms-1">View Certificate</a>
                                    <% } else { %>
                                        <span class="text-muted ms-1">None uploaded</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EDIT OPERATIONAL DETAILS FORM -->
                <div class="col-lg-7">
                    <div class="dashboard-card">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title">Contact &amp; Location Details</span>
                        </div>
                        <div class="dashboard-card-body p-4">
                            <form action="/vendor/profile" method="POST" class="needs-validation" novalidate>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Business Email</label>
                                    <input type="email" class="form-control bg-light" value="<%= currentVendor.business_email || currentUser.email %>" readonly disabled>
                                    <div class="form-text">To update your official email, please contact platform administrators.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Operational Mobile / WhatsApp <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">+91</span>
                                        <input type="tel" name="business_mobile" class="form-control" pattern="^[6-9][0-9]{9}$" maxlength="10" required value="<%= currentVendor.business_mobile || currentUser.mobile || '' %>">
                                    </div>
                                    <div class="form-text">Customers and dispatch partners will coordinate orders on this number.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Store Street Address <span class="text-danger">*</span></label>
                                    <textarea name="address" class="form-control" rows="2" required><%= currentVendor.address || '' %></textarea>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                                        <input type="text" name="city" class="form-control" required value="<%= currentVendor.city || '' %>">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">State <span class="text-danger">*</span></label>
                                        <input type="text" name="state" class="form-control" required value="<%= currentVendor.state || '' %>">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">Pincode <span class="text-danger">*</span></label>
                                        <input type="text" name="pincode" class="form-control" pattern="^[0-9]{6}$" maxlength="6" required value="<%= currentVendor.pincode || '' %>">
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary px-4 py-2" style="background-color: var(--primary); border-color: var(--primary);">
                                    <i class="bi bi-save me-1"></i> Save Changes
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
