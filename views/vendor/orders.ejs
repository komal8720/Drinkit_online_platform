<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "orders" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Customer Orders</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- HEADER -->
            <div class="mb-4">
                <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Store Orders (<%= totalOrders %>)</h1>
                <p class="text-muted mb-0 small">Track beverage fulfillment, packaging, and pickup readiness</p>
            </div>

            <!-- FILTERS -->
            <div class="dashboard-card mb-4">
                <div class="dashboard-card-body p-3">
                    <form method="GET" action="/vendor/orders" class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Order #..." value="<%= search || '' %>">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select name="status" class="form-select">
                                <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Statuses</option>
                                <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="confirmed" <%= statusFilter === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                <option value="preparing" <%= statusFilter === 'preparing' ? 'selected' : '' %>>Preparing</option>
                                <option value="ready_for_pickup" <%= statusFilter === 'ready_for_pickup' ? 'selected' : '' %>>Ready for Pickup</option>
                                <option value="delivered" <%= statusFilter === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
                            <% if (search || statusFilter !== 'all') { %>
                                <a href="/vendor/orders" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ORDERS TABLE -->
            <div class="dashboard-card">
                <div class="dashboard-card-body p-0">
                    <% if (orders && orders.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Order Date</th>
                                        <th>Customer</th>
                                        <th>Items Ordered</th>
                                        <th>Your Share Total</th>
                                        <th>Payment</th>
                                        <th>Order Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% orders.forEach(o => { %>
                                        <tr>
                                            <td class="fw-bold">
                                                <a href="/vendor/orders/<%= o.id %>" class="text-decoration-none text-dark"><%= o.order_number %></a>
                                            </td>
                                            <td class="text-muted small">
                                                <%= new Date(o.created_at).toLocaleString("en-IN", { dateStyle: 'medium', timeStyle: 'short' }) %>
                                            </td>
                                            <td>
                                                <div class="fw-semibold"><%= o.customer_name %></div>
                                                <small class="text-muted"><%= o.customer_mobile || '' %></small>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1"><%= o.item_count %> items</span>
                                            </td>
                                            <td class="fw-bold text-success">
                                                ₹<%= Number(o.vendor_total).toFixed(2) %>
                                            </td>
                                            <td>
                                                <% if (o.payment_status === 'completed' || o.payment_status === 'paid') { %>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Paid</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><%= o.payment_status %></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (o.order_status === 'delivered') { %>
                                                    <span class="badge bg-success text-white">Delivered</span>
                                                <% } else if (o.order_status === 'cancelled') { %>
                                                    <span class="badge bg-danger text-white">Cancelled</span>
                                                <% } else if (o.order_status === 'confirmed' || o.order_status === 'preparing') { %>
                                                    <span class="badge bg-info text-dark"><%= o.order_status %></span>
                                                <% } else if (o.order_status === 'ready_for_pickup') { %>
                                                    <span class="badge bg-primary text-white">Ready for Pickup</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark"><%= o.order_status %></span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <a href="/vendor/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-box-seam me-1"></i> Manage
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- PAGINATION -->
                        <% if (totalPages > 1) { %>
                            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                                <div class="text-muted small">
                                    Showing page <%= currentPageNum %> of <%= totalPages %> (<%= totalOrders %> total orders)
                                </div>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item <%= currentPageNum <= 1 ? 'disabled' : '' %>">
                                            <a class="page-link" href="?page=<%= currentPageNum - 1 %>&search=<%= search || '' %>&status=<%= statusFilter %>">Previous</a>
                                        </li>
                                        <% for (let p = 1; p <= totalPages; p++) { %>
                                            <li class="page-item <%= p === currentPageNum ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= p %>&search=<%= search || '' %>&status=<%= statusFilter %>"><%= p %></a>
                                            </li>
                                        <% } %>
                                        <li class="page-item <%= currentPageNum >= totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" href="?page=<%= currentPageNum + 1 %>&search=<%= search || '' %>&status=<%= statusFilter %>">Next</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        <% } %>

                    <% } else { %>
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-bag-check display-5 d-block mb-3"></i>
                            No orders found matching your search.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
