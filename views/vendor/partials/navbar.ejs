<header class="admin-navbar">
    <div class="d-flex align-items-center gap-3">
        <button class="navbar-toggle-btn" id="sidebarToggle" type="button" title="Toggle Navigation">
            <i class="bi bi-list fs-5"></i>
        </button>
        <div class="navbar-page-title d-none d-md-block">
            <span class="fw-semibold"><%= currentVendor ? currentVendor.business_name : 'Drinkit Vendor' %></span>
            <span class="badge bg-light text-secondary border ms-2">Vendor #<%= currentVendor ? currentVendor.id : '' %></span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3">
        <!-- NOTIFICATIONS ICON -->
        <a href="/vendor/notifications" class="nav-icon-btn position-relative" title="Notifications">
            <i class="bi bi-bell"></i>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                    <%= unreadCount %>
                </span>
            <% } %>
        </a>

        <!-- USER DROPDOWN -->
        <div class="dropdown">
            <button class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="admin-avatar" style="width: 36px; height: 36px; background-color: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 600;">
                    <%= (currentVendor && currentVendor.owner_name ? currentVendor.owner_name[0] : 'V').toUpperCase() %>
                </div>
                <div class="d-none d-md-block text-start">
                    <div class="fw-semibold text-dark small line-clamp-1"><%= currentVendor ? currentVendor.owner_name : 'Vendor' %></div>
                    <div class="text-muted" style="font-size: 0.75rem;">@<%= currentUser ? currentUser.username : 'vendor' %></div>
                </div>
                <i class="bi bi-chevron-down text-muted small"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><h6 class="dropdown-header">Logged in as Vendor</h6></li>
                <li>
                    <a class="dropdown-item" href="/vendor/profile">
                        <i class="bi bi-person me-2"></i> Store Profile
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/vendor/earnings">
                        <i class="bi bi-cash-coin me-2"></i> Earnings & Payouts
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-danger" href="/vendor/logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>
