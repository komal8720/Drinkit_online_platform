<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "notifications" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Notifications</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- HEADER -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Store Notifications</h1>
                    <p class="text-muted mb-0 small">Operational alerts, verification updates, and new order events</p>
                </div>
                <% if (notifications && notifications.some(n => !n.is_read)) { %>
                    <form action="/vendor/notifications/read-all" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-check2-all me-1"></i> Mark All as Read
                        </button>
                    </form>
                <% } %>
            </div>

            <!-- NOTIFICATIONS LIST -->
            <div class="dashboard-card">
                <div class="dashboard-card-body p-0">
                    <% if (notifications && notifications.length > 0) { %>
                        <div class="list-group list-group-flush">
                            <% notifications.forEach(n => { %>
                                <div class="list-group-item p-3 <%= !n.is_read ? 'bg-light' : '' %> d-flex align-items-start gap-3">
                                    <div class="sidebar-brand-icon" style="background-color: <%= n.type === 'success' ? '#ECFDF5' : (n.type === 'warning' ? '#FEF3C7' : 'var(--primary-light)') %>; color: <%= n.type === 'success' ? '#10B981' : (n.type === 'warning' ? '#F59E0B' : 'var(--primary)') %>; box-shadow: none; width: 40px; height: 40px; font-size: 1.2rem; flex-shrink: 0;">
                                        <i class="bi <%= n.type === 'success' ? 'bi-check-circle' : (n.type === 'warning' ? 'bi-exclamation-circle' : 'bi-bell') %>"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="fw-bold mb-1 <%= !n.is_read ? 'text-primary' : 'text-dark' %>">
                                                <%= n.title %>
                                                <% if (!n.is_read) { %>
                                                    <span class="badge bg-danger rounded-pill ms-1" style="font-size: 0.6rem;">New</span>
                                                <% } %>
                                            </h6>
                                            <span class="text-muted small"><%= new Date(n.created_at).toLocaleString("en-IN", { dateStyle: 'short', timeStyle: 'short' }) %></span>
                                        </div>
                                        <p class="mb-1 text-muted small"><%= n.message %></p>
                                        <div class="d-flex gap-2 align-items-center mt-2">
                                            <% if (n.link) { %>
                                                <a href="<%= n.link %>" class="btn btn-sm btn-link p-0 text-decoration-none small" style="color: var(--primary);">View Details &rarr;</a>
                                            <% } %>
                                            <% if (!n.is_read) { %>
                                                <form action="/vendor/notifications/<%= n.id %>/read" method="POST" class="d-inline">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;">Mark Read</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-bell-slash display-5 d-block mb-3"></i>
                            No notifications at this time.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
