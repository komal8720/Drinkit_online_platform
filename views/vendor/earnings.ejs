<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "earnings" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Earnings &amp; Payouts</strong>
            </div>

            <!-- HEADER -->
            <div class="mb-4">
                <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Store Financial Overview</h1>
                <p class="text-muted mb-0 small">Real-time revenue reconciliation, platform fee deductions, and payout logs</p>
            </div>

            <!-- FINANCIAL SUMMARY CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">LIFETIME GROSS SALES</span>
                        <h3 class="fw-bold mb-0 text-dark">₹<%= Number(summary.totalGross).toFixed(2) %></h3>
                        <span class="text-muted small">Total item revenue</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">PLATFORM FEE DEDUCTED</span>
                        <h3 class="fw-bold mb-0 text-danger">₹<%= Number(summary.totalCommission).toFixed(2) %></h3>
                        <span class="text-muted small">Rate: <%= currentVendor.commission_rate %>% platform fee</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">NET PAYABLE TO YOU</span>
                        <h3 class="fw-bold mb-0 text-success">₹<%= Number(summary.totalNet).toFixed(2) %></h3>
                        <span class="text-muted small">Gross &minus; Commission</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="dashboard-card p-3">
                        <span class="text-muted small fw-semibold d-block mb-1">PENDING SETTLEMENT</span>
                        <h3 class="fw-bold mb-0 text-warning">₹<%= Number(summary.pendingPayout).toFixed(2) %></h3>
                        <span class="text-muted small">Scheduled in next payout cycle</span>
                    </div>
                </div>
            </div>

            <!-- PAYOUT TRANSACTIONS TABLE -->
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <span class="dashboard-card-title">Order Payout Records</span>
                </div>
                <div class="dashboard-card-body p-0">
                    <% if (payouts && payouts.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Order #</th>
                                        <th>Gross Amount</th>
                                        <th>Commission (<%= currentVendor.commission_rate %>%)</th>
                                        <th>Net Amount</th>
                                        <th>Payout Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% payouts.forEach(p => { %>
                                        <tr>
                                            <td class="text-muted small">
                                                <%= new Date(p.created_at).toLocaleDateString("en-IN", { dateStyle: 'medium' }) %>
                                            </td>
                                            <td class="fw-bold">
                                                <a href="/vendor/orders/<%= p.order_id %>" class="text-decoration-none text-dark">
                                                    <%= p.order_number %>
                                                </a>
                                            </td>
                                            <td class="fw-semibold">₹<%= Number(p.order_amount).toFixed(2) %></td>
                                            <td class="text-danger">-₹<%= Number(p.commission_amount).toFixed(2) %></td>
                                            <td class="fw-bold text-success">₹<%= Number(p.vendor_amount).toFixed(2) %></td>
                                            <td>
                                                <% if (p.status === 'paid') { %>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Paid / Settled</span>
                                                <% } else if (p.status === 'processed') { %>
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Processing</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Pending</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-cash-stack display-5 d-block mb-3"></i>
                            No payout records recorded yet.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
