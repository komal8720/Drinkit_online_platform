<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "products" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <strong>My Products</strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- HEADER -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Store Catalog (<%= totalProducts %>)</h1>
                    <p class="text-muted mb-0 small">Manage your inventory, bottle pricing, and stock levels</p>
                </div>
                <div>
                    <a href="/vendor/products/add" class="btn btn-primary d-inline-flex align-items-center gap-2" style="background-color: var(--primary); border-color: var(--primary);">
                        <i class="bi bi-plus-lg"></i>
                        <span>Add New Beverage</span>
                    </a>
                </div>
            </div>

            <!-- SEARCH & FILTERS -->
            <div class="dashboard-card mb-4">
                <div class="dashboard-card-body p-3">
                    <form method="GET" action="/vendor/products" class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by beverage name or SKU..." value="<%= search || '' %>">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select name="status" class="form-select">
                                <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Statuses</option>
                                <option value="approved" <%= statusFilter === 'approved' ? 'selected' : '' %>>Approved / Live</option>
                                <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending Review</option>
                                <option value="draft" <%= statusFilter === 'draft' ? 'selected' : '' %>>Draft</option>
                                <option value="inactive" <%= statusFilter === 'inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
                            <% if (search || statusFilter !== 'all') { %>
                                <a href="/vendor/products" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- PRODUCTS TABLE -->
            <div class="dashboard-card">
                <div class="dashboard-card-body p-0">
                    <% if (products && products.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table custom-table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>SKU</th>
                                        <th>Price / Sale</th>
                                        <th>Stock Quantity</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% products.forEach(p => { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div style="width: 44px; height: 44px; border-radius: 8px; overflow: hidden; background: #f8f9fa; border: 1px solid #eee; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                        <% if (p.image) { %>
                                                            <img src="<%= p.image %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: contain;">
                                                        <% } else { %>
                                                            <i class="bi bi-cup-straw text-muted fs-4"></i>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold"><%= p.name %></div>
                                                        <span class="text-muted small"><%= p.bottle_size || 'Standard bottle' %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= p.category_name || 'N/A' %></td>
                                            <td><code><%= p.sku %></code></td>
                                            <td>
                                                <div class="fw-semibold">₹<%= Number(p.price).toFixed(2) %></div>
                                                <% if (p.sale_price && Number(p.sale_price) < Number(p.price)) { %>
                                                    <small class="text-success">Sale: ₹<%= Number(p.sale_price).toFixed(2) %></small>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (p.stock_quantity <= 5) { %>
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><%= p.stock_quantity %> units (Low)</span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-dark border px-2 py-1"><%= p.stock_quantity %> units</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (p.status === 'approved') { %>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Approved</span>
                                                <% } else if (p.status === 'pending') { %>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Pending</span>
                                                <% } else if (p.status === 'inactive') { %>
                                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactive</span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-dark border px-2 py-1"><%= p.status %></span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <a href="/vendor/products/edit/<%= p.id %>" class="btn btn-sm btn-outline-primary" title="Edit Product">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form action="/vendor/products/toggle-status/<%= p.id %>" method="POST" class="d-inline">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="<%= p.status === 'approved' ? 'Set Inactive' : 'Activate' %>">
                                                            <i class="bi <%= p.status === 'approved' ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                                                        </button>
                                                    </form>
                                                    <form action="/vendor/products/delete/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.')">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Product">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- PAGINATION -->
                        <% if (totalPages > 1) { %>
                            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                                <div class="text-muted small">
                                    Showing page <%= currentPageNum %> of <%= totalPages %> (<%= totalProducts %> total products)
                                </div>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item <%= currentPageNum <= 1 ? 'disabled' : '' %>">
                                            <a class="page-link" href="?page=<%= currentPageNum - 1 %>&search=<%= search || '' %>&status=<%= statusFilter %>">Previous</a>
                                        </li>
                                        <% for (let p = 1; p <= totalPages; p++) { %>
                                            <li class="page-item <%= p === currentPageNum ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= p %>&search=<%= search || '' %>&status=<%= statusFilter %>"><%= p %></a>
                                            </li>
                                        <% } %>
                                        <li class="page-item <%= currentPageNum >= totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" href="?page=<%= currentPageNum + 1 %>&search=<%= search || '' %>&status=<%= statusFilter %>">Next</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        <% } %>

                    <% } else { %>
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-box-seam display-5 d-block mb-3"></i>
                            No products found matching your filter criteria.
                            <div class="mt-3">
                                <a href="/vendor/products/add" class="btn btn-sm btn-primary">Add Your First Product</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
