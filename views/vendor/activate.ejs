<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
    <style>
        body {
            background: linear-gradient(135deg, #FFF0F3 0%, #F5E6E8 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .activate-card {
            background: #fff;
            border-radius: var(--radius-lg);
            box-shadow: 0 12px 36px rgba(122, 21, 53, 0.12);
            width: 100%;
            max-width: 480px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .activate-header {
            background: var(--primary);
            color: #fff;
            padding: 32px 28px;
            text-align: center;
        }

        .activate-header-icon {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .activate-body {
            padding: 32px 28px;
        }

        .btn-activate {
            background-color: var(--primary);
            color: #fff;
            border: none;
            font-weight: 600;
            padding: 12px;
            border-radius: var(--radius-md);
            width: 100%;
            transition: var(--transition);
        }

        .btn-activate:hover {
            background-color: var(--primary-hover);
            color: #fff;
        }
    </style>
</head>

<body>
    <div class="activate-card">
        <div class="activate-header">
            <div class="activate-header-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h3 class="fw-bold mb-1">Activate Your Store</h3>
            <p class="mb-0 text-white-50 small">Set your password to launch your Drinkit vendor portal</p>
        </div>

        <div class="activate-body">
            <!-- FLASH MESSAGES -->
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- STORE GREETING -->
            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="d-flex align-items-center gap-3">
                    <div class="sidebar-brand-icon" style="background-color: var(--primary-light); color: var(--primary); box-shadow: none; width: 44px; height: 44px; font-size: 1.3rem;">
                        <i class="bi bi-shop"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark"><%= vendor.business_name %></h6>
                        <span class="text-muted small">Owner: <%= vendor.owner_name %></span>
                    </div>
                </div>
                <hr class="my-2 text-muted opacity-25">
                <div class="d-flex justify-content-between text-muted small">
                    <span>Login Username:</span>
                    <strong class="text-dark">@<%= user.username %></strong>
                </div>
            </div>

            <!-- PASSWORD FORM -->
            <form action="/vendor/activate/<%= token %>" method="POST" id="activateForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-muted">Create New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                        <input type="password" name="password" id="password" class="form-control border-start-0" placeholder="Minimum 8 characters" required minlength="8">
                    </div>
                    <div class="form-text small" id="pwdHelp">Must be at least 8 characters with letters, numbers, and symbols.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small text-muted">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-check2-circle"></i></span>
                        <input type="password" name="confirm_password" id="confirm_password" class="form-control border-start-0" placeholder="Repeat your password" required minlength="8">
                    </div>
                    <div class="text-danger small mt-1" id="matchError" style="display: none;">Passwords do not match.</div>
                </div>

                <button type="submit" class="btn btn-activate mb-3" id="submitBtn">
                    <i class="bi bi-check2-circle me-1"></i> Activate Store &amp; Login
                </button>

                <div class="text-center text-muted small">
                    Already have your password configured? <a href="/vendor/login" class="fw-semibold text-decoration-none" style="color: var(--primary);">Sign In</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const form = document.getElementById("activateForm");
        const pwd = document.getElementById("password");
        const cpwd = document.getElementById("confirm_password");
        const matchError = document.getElementById("matchError");

        form.addEventListener("submit", (e) => {
            if (pwd.value !== cpwd.value) {
                e.preventDefault();
                matchError.style.display = "block";
            } else {
                matchError.style.display = "none";
            }
        });

        cpwd.addEventListener("input", () => {
            if (cpwd.value && pwd.value !== cpwd.value) {
                matchError.style.display = "block";
            } else {
                matchError.style.display = "none";
            }
        });
    </script>
</body>

</html>
