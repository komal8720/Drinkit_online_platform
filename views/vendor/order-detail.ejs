<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin / Vendor CSS -->
    <link rel="stylesheet" href="/css/admin-layout.css">
</head>

<body>
    <!-- SIDEBAR -->
    <%- include("partials/sidebar", { currentPage: "orders" }) %>

    <!-- MAIN -->
    <main class="admin-main" id="adminMain">
        <!-- NAVBAR -->
        <%- include("partials/navbar") %>

        <!-- CONTENT -->
        <div class="admin-content">
            <!-- BREADCRUMB -->
            <div class="admin-breadcrumb">
                <a href="/vendor/dashboard">Vendor Portal</a>
                <i class="bi bi-chevron-right"></i>
                <a href="/vendor/orders">Orders</a>
                <i class="bi bi-chevron-right"></i>
                <strong>Order <%= order.order_number %></strong>
            </div>

            <!-- FLASH NOTIFICATIONS -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- HEADER -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Order #<%= order.order_number %></h1>
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <span>Placed on: <%= new Date(order.created_at).toLocaleString("en-IN", { dateStyle: 'full', timeStyle: 'short' }) %></span>
                        &bull;
                        <span>Status: <strong class="text-uppercase"><%= order.order_status %></strong></span>
                    </div>
                </div>
                <div>
                    <a href="/vendor/orders" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Orders
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <!-- VENDOR ITEMS IN ORDER -->
                <div class="col-lg-8">
                    <div class="dashboard-card mb-4">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title">Beverages Ordered from Your Store</span>
                        </div>
                        <div class="dashboard-card-body p-0">
                            <div class="table-responsive">
                                <table class="table custom-table mb-0 align-middle">
                                    <thead>
                                        <tr>
                                            <th>Item Details</th>
                                            <th>Unit Price</th>
                                            <th>Quantity</th>
                                            <th class="text-end">Item Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% let vendorSubtotal = 0; %>
                                        <% orderItems.forEach(item => { %>
                                            <% vendorSubtotal += Number(item.total_price); %>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div style="width: 40px; height: 40px; border-radius: 8px; overflow: hidden; background: #f8f9fa; border: 1px solid #eee; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                            <% if (item.image) { %>
                                                                <img src="<%= item.image %>" alt="<%= item.product_name %>" style="width: 100%; height: 100%; object-fit: contain;">
                                                            <% } else { %>
                                                                <i class="bi bi-cup-straw text-muted fs-5"></i>
                                                            <% } %>
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold"><%= item.product_name %></div>
                                                            <span class="text-muted small"><%= item.bottle_size || '' %></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>₹<%= Number(item.unit_price).toFixed(2) %></td>
                                                <td><span class="badge bg-light text-dark border"><%= item.quantity %></span></td>
                                                <td class="text-end fw-bold">₹<%= Number(item.total_price).toFixed(2) %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                    <tfoot>
                                        <tr class="bg-light">
                                            <td colspan="3" class="text-end fw-bold">Your Total Item Gross:</td>
                                            <td class="text-end fw-bold text-success fs-6">₹<%= Number(vendorSubtotal).toFixed(2) %></td>
                                        </tr>
                                        <% 
                                            const commFee = (vendorSubtotal * (Number(currentVendor.commission_rate) / 100));
                                            const netPayout = vendorSubtotal - commFee;
                                        %>
                                        <tr>
                                            <td colspan="3" class="text-end text-muted small">Platform Fee (<%= currentVendor.commission_rate %>%):</td>
                                            <td class="text-end text-danger small">-₹<%= Number(commFee).toFixed(2) %></td>
                                        </tr>
                                        <tr class="table-success">
                                            <td colspan="3" class="text-end fw-bold">Net Store Payout:</td>
                                            <td class="text-end fw-bold text-success">₹<%= Number(netPayout).toFixed(2) %></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SIDE CONTROLS & STATUS UPDATES -->
                <div class="col-lg-4">
                    <!-- FULFILLMENT STATUS UPDATE -->
                    <div class="dashboard-card mb-4">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title">Order Fulfillment Action</span>
                        </div>
                        <div class="dashboard-card-body p-4">
                            <div class="mb-3">
                                <label class="text-muted small d-block mb-1">Current State</label>
                                <span class="badge bg-primary fs-6 px-3 py-2 text-uppercase"><%= order.order_status %></span>
                            </div>

                            <% if (order.order_status !== 'delivered' && order.order_status !== 'cancelled') { %>
                                <form action="/vendor/orders/<%= order.id %>/status" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <label class="form-label fw-semibold small">Update Processing State</label>
                                    <select name="status" class="form-select mb-3">
                                        <% if (order.order_status === 'pending') { %>
                                            <option value="confirmed">Confirm Order</option>
                                            <option value="preparing">Start Preparing</option>
                                        <% } else if (order.order_status === 'confirmed') { %>
                                            <option value="preparing" selected>Start Preparing</option>
                                            <option value="ready_for_pickup">Ready for Pickup</option>
                                        <% } else if (order.order_status === 'preparing') { %>
                                            <option value="ready_for_pickup" selected>Ready for Pickup</option>
                                        <% } else if (order.order_status === 'ready_for_pickup') { %>
                                            <option value="ready_for_pickup" selected disabled>Waiting for Delivery Partner</option>
                                        <% } %>
                                    </select>

                                    <% if (order.order_status !== 'ready_for_pickup') { %>
                                        <button type="submit" class="btn btn-primary w-100" style="background-color: var(--primary); border-color: var(--primary);">
                                            <i class="bi bi-check2-circle me-1"></i> Update Status
                                        </button>
                                    <% } else { %>
                                        <p class="text-success small mb-0"><i class="bi bi-check2 me-1"></i>Order is packed and ready for pickup by the delivery fleet.</p>
                                    <% } %>
                                </form>
                            <% } else { %>
                                <div class="alert alert-light border small mb-0">
                                    This order has reached terminal status: <strong><%= order.order_status %></strong>.
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- CUSTOMER & DELIVERY INFO -->
                    <div class="dashboard-card">
                        <div class="dashboard-card-header">
                            <span class="dashboard-card-title">Delivery Details</span>
                        </div>
                        <div class="dashboard-card-body p-4">
                            <div class="mb-3">
                                <label class="text-muted small d-block">Customer Name</label>
                                <span class="fw-semibold"><%= order.customer_name %></span>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small d-block">Contact Phone</label>
                                <span><i class="bi bi-phone me-1 text-muted"></i><%= order.customer_mobile || 'Not provided' %></span>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small d-block">Delivery Address</label>
                                <span><%= order.delivery_address || 'Standard customer delivery address' %></span>
                            </div>
                            <% if (order.customer_note) { %>
                                <div class="p-2 bg-light rounded border small">
                                    <strong class="d-block text-muted">Customer Note:</strong>
                                    <%= order.customer_note %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <%- include("partials/footer") %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
