<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found | <%= appName %></title>
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/user/home.css">
</head>
<body>

    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>

    <!-- 404 CONTENT -->
    <div class="container my-5 py-5 text-center">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="logo-icon mb-4 d-inline-flex" style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, var(--drinkit-wine, #731b32), var(--drinkit-wine-dark, #4f1021)); color: #fff; align-items: center; justify-content: center; font-size: 45px; box-shadow: 0 10px 25px rgba(115, 27, 50, 0.2);">
                    <i class="bi bi-patch-question-fill"></i>
                </div>
                <h1 class="display-3 fw-bold mb-3" style="color: var(--drinkit-wine, #731b32);">404</h1>
                <h3 class="fw-bold mb-3">Oops! Page Not Found</h3>
                <p class="text-muted mb-4">
                    The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Let's get you back to enjoying your favorite beverages!
                </p>
                <a href="/" class="btn px-4 py-3 rounded-pill fw-bold text-white shadow" style="background: linear-gradient(135deg, var(--drinkit-wine, #731b32), var(--drinkit-wine-dark, #4f1021)); box-shadow: 0 4px 15px rgba(115, 27, 50, 0.22); transition: 0.2s;">
                    <i class="bi bi-house-door me-2"></i>Back to Home
                </a>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
