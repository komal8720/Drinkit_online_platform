<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Global CSS -->
    <link rel="stylesheet" href="/css/user/home.css">
    
    <!-- Wishlist Custom CSS -->
    <link rel="stylesheet" href="/css/user/wishlist.css">
</head>

<body>

    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>

    <!-- MAIN CONTAINER -->
    <div class="wishlist-container">
        
        <!-- Breadcrumb -->
        <div class="wishlist-breadcrumb">
            <a href="/">Home</a> <i class="bi bi-chevron-right mx-1 small"></i> <span>Wishlist</span>
        </div>

        <!-- HEADER -->
        <div class="wishlist-header d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <h1>
                    My Wishlist
                    <span class="wishlist-count-badge wishlist-count-text">
                        <%= wishlistItems.length %> <%= wishlistItems.length === 1 ? 'Item' : 'Items' %>
                    </span>
                </h1>
                <p>Your favourite products, saved in one place.</p>
            </div>
        </div>

        <!-- WISHLIST PRODUCTS GRID -->
        <div id="wishlistGridContainer" style="<%= wishlistItems.length === 0 ? 'display: none;' : '' %>">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                <% wishlistItems.forEach(product => { %>
                    <div class="col wishlist-item-card" data-product-id="<%= product.id %>">
                        <!-- Image Container -->
                        <div class="wishlist-image-container">
                            <!-- Absolute Heart Toggle -->
                            <button class="wishlist-heart-btn wishlist-btn active" data-product-id="<%= product.id %>" aria-label="Remove from wishlist">
                                <i class="bi bi-heart-fill"></i>
                            </button>
                            
                            <a href="/product/<%= product.slug %>">
                                <img src="<%= product.image || '/images/beer.jpg' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                            </a>
                        </div>
                        
                        <!-- Content -->
                        <div class="wishlist-item-category">
                            <%= product.category_name || 'Beverage' %>
                        </div>
                        
                        <h3 class="wishlist-item-name">
                            <a href="/product/<%= product.slug %>" class="text-decoration-none text-dark">
                                <%= product.name %>
                            </a>
                        </h3>
                        
                        <div class="wishlist-item-size">
                            <%= product.bottle_size || 'Standard Size' %>
                        </div>
                        
                        <!-- Price -->
                        <div class="wishlist-item-price-block">
                            <span class="wishlist-price-current">₹<%= parseInt(product.price) %></span>
                            <% if (product.sale_price && product.sale_price > product.price) { %>
                                <span class="wishlist-price-original">₹<%= parseInt(product.sale_price) %></span>
                                <% const pct = Math.round(((product.sale_price - product.price) / product.sale_price) * 100); %>
                                <span class="wishlist-discount-badge"><%= pct %>% OFF</span>
                            <% } %>
                        </div>
                        
                        <!-- Action buttons -->
                        <div>
                            <button class="wishlist-add-to-cart-btn add-cart-btn" data-product-id="<%= product.id %>">
                                <i class="bi bi-bag-plus"></i>Add to Cart
                            </button>
                            
                            <button class="wishlist-remove-btn wishlist-btn" data-product-id="<%= product.id %>">
                                <i class="bi bi-trash3"></i>Remove from Wishlist
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- EMPTY WISHLIST STATE -->
        <div id="wishlistEmptyContainer" style="<%= wishlistItems.length > 0 ? 'display: none;' : '' %>">
            <div class="wishlist-empty-card">
                <div class="wishlist-empty-icon">
                    <i class="bi bi-heart"></i>
                </div>
                <h2>Your Wishlist is Empty</h2>
                <p>Save your favourite products here and easily find them whenever you want.</p>
                <a href="/products" class="wishlist-explore-btn">
                    Explore Products <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <%- include('../partials/footer.ejs') %>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/cart-handler.js"></script>
</body>

</html>
