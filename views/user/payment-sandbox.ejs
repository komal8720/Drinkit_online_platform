<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f7f9fc;
            font-family: sans-serif;
        }
        .payment-box {
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            max-width: 480px;
            margin: 80px auto;
            border: 1px solid #eef2f5;
            overflow: hidden;
        }
        .payment-header {
            background-color: #731b32; /* Drinkit Wine color */
            color: #ffffff;
            padding: 24px;
            text-align: center;
        }
        .payment-header h3 {
            font-weight: 800;
            font-size: 20px;
            margin: 0;
        }
        .payment-header p {
            font-size: 13px;
            opacity: 0.8;
            margin: 4px 0 0 0;
        }
        .payment-body {
            padding: 30px;
        }
        .order-meta-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
            color: #555;
            font-weight: 600;
        }
        .amount-row {
            border-top: 1px dashed #eef2f5;
            border-bottom: 1px dashed #eef2f5;
            padding: 16px 0;
            margin: 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .amount-label {
            font-weight: 700;
            font-size: 16px;
            color: #2c2527;
        }
        .amount-value {
            font-weight: 800;
            font-size: 24px;
            color: #731b32;
        }
        .payment-methods-logos {
            display: flex;
            justify-content: center;
            gap: 15px;
            font-size: 24px;
            color: #888082;
            margin-bottom: 25px;
        }
        .btn-payment-action {
            width: 100%;
            padding: 14px 20px;
            font-weight: 700;
            border-radius: 12px;
            border: none;
            margin-bottom: 12px;
            transition: all 0.2s ease;
        }
        .btn-payment-success {
            background-color: #198754;
            color: #ffffff;
        }
        .btn-payment-success:hover {
            background-color: #157347;
        }
        .btn-payment-fail {
            background-color: #dc3545;
            color: #ffffff;
        }
        .btn-payment-fail:hover {
            background-color: #bb2d3b;
        }
        .btn-payment-cancel {
            background-color: transparent;
            color: #888082;
            border: 1px solid #dcd7d8;
        }
        .btn-payment-cancel:hover {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="payment-box">
        <!-- Header -->
        <div class="payment-header">
            <h3><i class="bi bi-shield-lock-fill me-1"></i> Secure Payment Gateway</h3>
            <p>DRINKIT ONLINE TRANSACTION SERVICE</p>
        </div>

        <!-- Body -->
        <div class="payment-body">
            
            <div class="text-center mb-4">
                <span class="badge bg-secondary p-2 small mb-2"><i class="bi bi-cpu me-1"></i> Sandbox Environment</span>
                <p class="text-muted small">You are in payment simulation mode. No real money will be charged.</p>
            </div>

            <!-- Order Details -->
            <div class="order-meta-row">
                <span>Order Number:</span>
                <span class="text-dark"><%= order.order_number %></span>
            </div>

            <div class="order-meta-row">
                <span>Payment Method:</span>
                <span class="text-dark text-uppercase"><%= order.payment_method %></span>
            </div>

            <!-- Amount -->
            <div class="amount-row">
                <span class="amount-label">Amount to Pay</span>
                <span class="amount-value">₹<%= parseInt(order.total_amount) %></span>
            </div>

            <!-- Payment Methods Icons -->
            <div class="payment-methods-logos">
                <i class="bi bi-credit-card"></i>
                <i class="bi bi-wallet2"></i>
                <i class="bi bi-bank"></i>
            </div>

            <!-- Action buttons -->
            <button class="btn-payment-action btn-payment-success" id="btnPaySuccess">
                <i class="bi bi-check-circle-fill me-1"></i> Simulate Payment Success
            </button>

            <button class="btn-payment-action btn-payment-fail" id="btnPayFail">
                <i class="bi bi-x-circle-fill me-1"></i> Simulate Payment Failure
            </button>

            <button class="btn-payment-action btn-payment-cancel" id="btnPayCancel">
                Cancel Transaction
            </button>

            <div class="text-center mt-3">
                <small class="text-muted" style="font-size: 11px;">
                    <i class="bi bi-lock-fill"></i> SSL Secured 256-bit Encryption
                </small>
            </div>

        </div>
    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(document).ready(function() {
    
    const orderId = <%= order.id %>;

    function processPayment(status) {
        // Disable buttons
        $(".btn-payment-action").prop("disabled", true);
        if (status === 'success') {
            $("#btnPaySuccess").text("Processing transaction...");
        } else {
            $("#btnPayFail").text("Cancelling transaction...");
        }

        $.ajax({
            url: "/checkout/payment/callback",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({ orderId, status }),
            success: function(data) {
                if (data.success && data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert(data.message || "Failed to process transaction.");
                    $(".btn-payment-action").prop("disabled", false);
                    restoreButtonsText();
                }
            },
            error: function() {
                alert("Network communication error.");
                $(".btn-payment-action").prop("disabled", false);
                restoreButtonsText();
            }
        });
    }

    function restoreButtonsText() {
        $("#btnPaySuccess").html('<i class="bi bi-check-circle-fill me-1"></i> Simulate Payment Success');
        $("#btnPayFail").html('<i class="bi bi-x-circle-fill me-1"></i> Simulate Payment Failure');
    }

    $("#btnPaySuccess").on("click", function() {
        processPayment("success");
    });

    $("#btnPayFail, #btnPayCancel").on("click", function() {
        processPayment("failed");
    });

});
</script>
</body>
</html>
