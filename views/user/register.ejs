<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - <%= appName %></title>
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/user/home.css">
</head>
<body>

    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>

    <!-- REGISTRATION FORM -->
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                
                <!-- FLASH MESSAGES -->
                <% if (success && success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div id="localAlertContainer"></div>

                <% if (error && error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5" style="border: 1px solid var(--drinkit-border, #e8e4e5) !important;">
                    <div class="text-center mb-4">
                        <span class="logo-icon mb-3 d-inline-flex" style="width: 50px; height: 50px; border-radius: 12px; background: linear-gradient(135deg, var(--drinkit-wine, #731b32), var(--drinkit-wine-dark, #4f1021)); color: #fff; align-items: center; justify-content: center; font-size: 22px;">
                            <i class="bi bi-person-plus-fill"></i>
                        </span>
                        <h2 class="fw-bold" style="color: var(--drinkit-wine, #731b32);">Create Account</h2>
                        <p class="text-muted small">Register to order premium beverages instantly</p>
                    </div>

                    <form action="/auth/register" method="POST" id="registrationForm">
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label for="first_name" class="form-label fw-semibold text-secondary">First Name *</label>
                                <input type="text" class="form-control" id="first_name" name="first_name" placeholder="Enter your first name" required>
                            </div>
                            <div class="col-sm-6">
                                <label for="last_name" class="form-label fw-semibold text-secondary">Last Name</label>
                                <input type="text" class="form-control" id="last_name" name="last_name" placeholder="Enter your last name">
                            </div>
                        </div>

                        <!-- Email Address with OTP -->
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold text-secondary">Email Address *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-start-0 border-end-0 ps-0" id="email" name="email" placeholder="Enter your email address" required>
                                <button class="btn btn-outline-secondary" type="button" id="btnSendOtp" style="border-radius: 0 9px 9px 0; font-weight: 600;">Send OTP</button>
                            </div>
                            <div id="otpStatus" class="form-text mt-1 d-none"></div>
                        </div>

                        <!-- OTP Input Group (Hidden initially) -->
                        <div class="mb-3 d-none" id="otpSection">
                            <label for="otp" class="form-label fw-semibold text-secondary">Enter OTP *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                                <input type="text" class="form-control border-start-0 border-end-0 ps-0" id="otp" placeholder="Enter 6-digit OTP" maxlength="6">
                                <button class="btn btn-secondary" type="button" id="btnVerifyOtp" style="border-radius: 0 9px 9px 0; background: var(--drinkit-wine, #731b32); color: white; border: none; font-weight: 600;">Verify OTP</button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="mobile" class="form-label fw-semibold text-secondary">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                <input type="tel" class="form-control border-start-0 ps-0" id="mobile" name="mobile" placeholder="Enter your mobile number">
                            </div>
                        </div>

                        <!-- Password + Confirm Password with Eye Toggle -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label for="password" class="form-label fw-semibold text-secondary">Password *</label>
                                <div class="input-group">
                                    <input type="password" class="form-control border-end-0" id="password" name="password" placeholder="••••••••" required>
                                    <span class="input-group-text bg-transparent border-start-0 text-muted" style="cursor: pointer;" id="toggleRegPassword">
                                        <i class="bi bi-eye" id="toggleRegPasswordIcon"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label for="confirm_password" class="form-label fw-semibold text-secondary">Confirm Password *</label>
                                <div class="input-group">
                                    <input type="password" class="form-control border-end-0" id="confirm_password" name="confirm_password" placeholder="••••••••" required>
                                    <span class="input-group-text bg-transparent border-start-0 text-muted" style="cursor: pointer;" id="toggleConfirmPassword">
                                        <i class="bi bi-eye" id="toggleConfirmPasswordIcon"></i>
                                    </span>
                                </div>
                                <div id="passwordMatchWarning" class="form-text text-danger mt-1 fw-semibold d-none">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Passwords do not match.
                                </div>
                            </div>
                        </div>

                        <!-- Register Submit Button (Disabled until OTP verified) -->
                        <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold text-white" id="btnSubmitRegister" disabled style="background: var(--drinkit-muted, #707070); border: none; opacity: 0.65; transition: 0.2s;">
                            Register
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0 small">Already have an account? <a href="/auth/login" class="fw-semibold text-decoration-none" style="color: var(--drinkit-wine, #731b32);">Login here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Client-Side Form Interactions Script -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const passwordInput = document.getElementById("password");
            const confirmInput = document.getElementById("confirm_password");
            const warningMsg = document.getElementById("passwordMatchWarning");
            const submitBtn = document.getElementById("btnSubmitRegister");
            
            const toggleRegPassword = document.getElementById("toggleRegPassword");
            const toggleRegPasswordIcon = document.getElementById("toggleRegPasswordIcon");
            const toggleConfirmPassword = document.getElementById("toggleConfirmPassword");
            const toggleConfirmPasswordIcon = document.getElementById("toggleConfirmPasswordIcon");

            const emailInput = document.getElementById("email");
            const btnSendOtp = document.getElementById("btnSendOtp");
            const otpSection = document.getElementById("otpSection");
            const otpInput = document.getElementById("otp");
            const btnVerifyOtp = document.getElementById("btnVerifyOtp");
            const otpStatus = document.getElementById("otpStatus");
            const localAlertContainer = document.getElementById("localAlertContainer");

            let isOtpVerified = false;

            // Helper to show soft alert
            function showLocalAlert(message, type = 'danger') {
                localAlertContainer.innerHTML = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
            }

            // 1. Password Visibility Toggle
            if (toggleRegPassword && passwordInput) {
                toggleRegPassword.addEventListener("click", () => {
                    const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                    passwordInput.setAttribute("type", type);
                    toggleRegPasswordIcon.className = type === "text" ? "bi bi-eye-slash" : "bi bi-eye";
                });
            }

            if (toggleConfirmPassword && confirmInput) {
                toggleConfirmPassword.addEventListener("click", () => {
                    const type = confirmInput.getAttribute("type") === "password" ? "text" : "password";
                    confirmInput.setAttribute("type", type);
                    toggleConfirmPasswordIcon.className = type === "text" ? "bi bi-eye-slash" : "bi bi-eye";
                });
            }

            // 2. Real-Time Password Match Warning (Soft warning)
            function validatePasswords() {
                const pass = passwordInput.value;
                const confirm = confirmInput.value;

                if (confirm.length === 0) {
                    warningMsg.classList.add("d-none");
                    updateSubmitState();
                    return;
                }

                if (pass !== confirm) {
                    warningMsg.classList.remove("d-none");
                } else {
                    warningMsg.classList.add("d-none");
                }
                updateSubmitState();
            }

            passwordInput.addEventListener("input", validatePasswords);
            confirmInput.addEventListener("input", validatePasswords);

            function updateSubmitState() {
                const pass = passwordInput.value;
                const confirm = confirmInput.value;
                const passwordsMatch = pass === confirm && pass.length > 0;

                if (isOtpVerified && passwordsMatch) {
                    submitBtn.removeAttribute("disabled");
                    submitBtn.style.background = "linear-gradient(135deg, var(--drinkit-wine, #731b32), var(--drinkit-wine-dark, #4f1021))";
                    submitBtn.style.boxShadow = "0 4px 15px rgba(115, 27, 50, 0.22)";
                    submitBtn.style.opacity = "1";
                } else {
                    submitBtn.setAttribute("disabled", "true");
                    submitBtn.style.background = "var(--drinkit-muted, #707070)";
                    submitBtn.style.boxShadow = "none";
                    submitBtn.style.opacity = "0.65";
                }
            }

            // 3. Send OTP
            btnSendOtp.addEventListener("click", async () => {
                const email = emailInput.value.trim();
                const firstName = document.getElementById("first_name").value.trim() || "User";
                if (!email) {
                    showLocalAlert("Please enter a valid email address first.");
                    return;
                }

                btnSendOtp.setAttribute("disabled", "true");
                btnSendOtp.textContent = "Sending...";

                try {
                    const response = await fetch("/auth/send-otp", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ email, first_name: firstName })
                    });
                    const data = await response.json();

                    if (data.success) {
                        showLocalAlert("OTP verification email has been sent successfully. Please check your inbox!", "success");
                        otpSection.classList.remove("d-none");
                        otpStatus.classList.remove("d-none", "text-danger");
                        otpStatus.classList.add("text-success");
                        otpStatus.textContent = "OTP sent to email. Enter it below.";
                    } else {
                        showLocalAlert(data.message || "Failed to send OTP.");
                        btnSendOtp.removeAttribute("disabled");
                        btnSendOtp.textContent = "Send OTP";
                    }
                } catch (err) {
                    console.error("Error sending OTP:", err);
                    showLocalAlert("Connection error. Could not request OTP.");
                    btnSendOtp.removeAttribute("disabled");
                    btnSendOtp.textContent = "Send OTP";
                }
            });

            // 4. Verify OTP
            btnVerifyOtp.addEventListener("click", async () => {
                const email = emailInput.value.trim();
                const otp = otpInput.value.trim();

                if (!otp) {
                    showLocalAlert("Please enter the 6-digit OTP.");
                    return;
                }

                try {
                    const response = await fetch("/auth/verify-otp", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ email, otp })
                    });
                    const data = await response.json();

                    if (data.success) {
                        isOtpVerified = true;
                        showLocalAlert("Email verified successfully! You can now complete registration.", "success");
                        
                        // Disable email input so it cannot be altered after verification
                        emailInput.setAttribute("readonly", "true");
                        btnSendOtp.setAttribute("disabled", "true");
                        btnSendOtp.textContent = "Verified ✓";
                        
                        // Hide OTP section and status
                        otpSection.classList.add("d-none");
                        otpStatus.textContent = "Email Verified ✓";
                        
                        updateSubmitState();
                    } else {
                        showLocalAlert(data.message || "Invalid OTP. Please check the Server Console/Terminal.");
                    }
                } catch (err) {
                    console.error("Error verifying OTP:", err);
                    showLocalAlert("Connection error. Could not verify OTP.");
                }
            });
        });
    </script>
</body>
</html>
