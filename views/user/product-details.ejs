<!DOCTYPE html>
<html lang="<%= langCode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Home CSS (for grid, product card styles) -->
    <link rel="stylesheet" href="/css/user/home.css">
    <style>
        .product-details-container {
            padding-top: 40px;
            padding-bottom: 80px;
            min-height: 80vh;
        }
        .breadcrumb-item a {
            font-weight: 600;
            color: var(--drinkit-muted) !important;
        }
        .breadcrumb-item.active {
            font-weight: 700;
            color: var(--drinkit-text) !important;
        }
        .product-main-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid var(--drinkit-border);
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
            margin-bottom: 40px;
        }
        .details-image-wrapper {
            border: 1px solid var(--drinkit-border);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            background: #fafafa;
            position: relative;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .details-image-wrapper img {
            max-height: 380px;
            max-width: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }
        .details-image-wrapper img:hover {
            transform: scale(1.05);
        }
        .details-category-badge {
            display: inline-block;
            background: var(--drinkit-wine-light);
            color: var(--drinkit-wine);
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 50px;
            margin-bottom: 15px;
            letter-spacing: 0.5px;
        }
        .details-title {
            font-size: 32px;
            font-weight: 800;
            color: var(--drinkit-text);
            margin-bottom: 10px;
            line-height: 1.2;
        }
        .details-brand {
            font-size: 16px;
            font-weight: 600;
            color: var(--drinkit-muted);
            margin-bottom: 20px;
        }
        .details-size {
            font-size: 14px;
            font-weight: 700;
            color: var(--drinkit-text);
            background: #f1f1f1;
            padding: 6px 14px;
            border-radius: 8px;
            display: inline-block;
            margin-bottom: 25px;
        }
        .details-price-wrapper {
            border-top: 1px solid var(--drinkit-border);
            border-bottom: 1px solid var(--drinkit-border);
            padding: 20px 0;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .details-price {
            font-size: 30px;
            font-weight: 800;
            color: var(--drinkit-wine);
        }
        .details-sale-price {
            font-size: 20px;
            color: var(--drinkit-muted);
            text-decoration: line-through;
        }
        .details-discount-badge {
            background: #28a745;
            color: #ffffff;
            font-weight: 700;
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 6px;
        }
        .details-action-buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }
        .details-add-btn {
            background: var(--drinkit-wine);
            color: #ffffff;
            font-weight: 700;
            font-size: 16px;
            padding: 12px 36px;
            border: none;
            border-radius: 12px;
            transition: 0.2s ease;
            flex-grow: 1;
            max-width: 250px;
        }
        .details-add-btn:hover {
            background: var(--drinkit-wine-dark);
        }
        .details-wishlist-btn {
            background: #ffffff;
            border: 1px solid var(--drinkit-border);
            border-radius: 12px;
            height: 50px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: 700;
            color: var(--drinkit-muted);
            transition: 0.2s ease;
            gap: 8px;
        }
        .details-wishlist-btn:hover, .details-wishlist-btn.active {
            color: var(--drinkit-wine);
            border-color: var(--drinkit-wine);
            background: var(--drinkit-wine-light);
        }
        .spec-table th {
            width: 30%;
            font-weight: 700;
            color: var(--drinkit-muted);
            border-bottom: 1px solid #f1f1f1;
            padding: 12px 0;
        }
        .spec-table td {
            color: var(--drinkit-text);
            font-weight: 600;
            border-bottom: 1px solid #f1f1f1;
            padding: 12px 0;
        }
        .related-title h3 {
            font-size: 24px;
            font-weight: 800;
            color: var(--drinkit-text);
            margin-bottom: 25px;
        }
        .related-title h3 span {
            color: var(--drinkit-wine);
        }
    </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container product-details-container">
    
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="background: transparent; padding: 0;">
            <li class="breadcrumb-item">
                <a href="/" class="text-decoration-none">
                    <i class="bi bi-house-door-fill me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/products" class="text-decoration-none">Shop</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/products?category=<%= product.category_slug %>" class="text-decoration-none">
                    <%= product.category_name %>
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <%= product.name %>
            </li>
        </ol>
    </nav>

    <!-- Main Product Section -->
    <div class="product-main-card">
        <div class="row g-5">
            <!-- Left: Product Image -->
            <div class="col-md-6">
                <div class="details-image-wrapper">
                    <img 
                        src="<%= product.image || '/images/beer.jpg' %>" 
                        alt="<%= product.name %>" 
                        onerror="this.onerror=null;this.src='/images/beer.jpg';"
                    >
                </div>
            </div>
            
            <!-- Right: Product Info & Actions -->
            <div class="col-md-6">
                <span class="details-category-badge">
                    <%= product.category_name %>
                </span>
                
                <h1 class="details-title">
                    <%= product.name %>
                </h1>
                
                <% if (product.brand_name) { %>
                    <div class="details-brand">
                        Brand: <span class="text-dark font-weight-bold"><%= product.brand_name %></span>
                    </div>
                <% } %>
                
                <% if (product.bottle_size) { %>
                    <div class="details-size">
                        <i class="bi bi-tag-fill me-1"></i>Volume: <%= product.bottle_size %>
                    </div>
                <% } %>
                
                <div class="details-price-wrapper">
                    <div class="details-price">
                        ₹<%= parseInt(product.price) %>
                    </div>
                    <% if (product.sale_price) { %>
                        <div class="details-sale-price">
                            ₹<%= parseInt(product.sale_price) %>
                        </div>
                        <% const pct = Math.round(((product.sale_price - product.price) / product.sale_price) * 100); %>
                        <% if (pct > 0) { %>
                            <span class="details-discount-badge"><%= pct %>% OFF</span>
                        <% } %>
                    <% } %>
                </div>

                <div class="details-action-buttons">
                    <button class="details-add-btn add-cart-btn" data-product-id="<%= product.id %>">
                        <i class="bi bi-plus-lg me-2"></i>Add to Cart
                    </button>
                    <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(product.id); %>
                    <button class="details-wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= product.id %>">
                        <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                        <span class="wishlist-text"><%= isWishlisted ? 'In Wishlist' : 'Add to Wishlist' %></span>
                    </button>
                </div>

                <!-- Stock availability -->
                <div class="mb-4">
                    <% if (product.stock_quantity > 0) { %>
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> In Stock</span>
                    <% } else { %>
                        <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Temporarily Out of Stock</span>
                    <% } %>
                </div>

                <!-- Product Specifications -->
                <div class="mt-4 pt-4 border-top">
                    <h4 class="h6 text-uppercase fw-bold text-muted mb-3">Product Specifications</h4>
                    <table class="table spec-table">
                        <tbody>
                            <tr>
                                <th>Category</th>
                                <td><%= product.category_name %></td>
                            </tr>
                            <% if (product.brand_name) { %>
                                <tr>
                                    <th>Brand</th>
                                    <td><%= product.brand_name %></td>
                                </tr>
                            <% } %>
                            <% if (product.alcohol_percentage !== null) { %>
                                <tr>
                                    <th>Alcohol Vol %</th>
                                    <td><%= product.alcohol_percentage %>% v/v</td>
                                </tr>
                            <% } %>
                            <tr>
                                <th>SKU</th>
                                <td><%= product.sku || 'N/A' %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Description -->
        <div class="row mt-5 pt-4 border-top">
            <div class="col-12">
                <h4 class="h5 fw-bold text-dark mb-3">Product Description</h4>
                <p class="text-muted leading-relaxed" style="font-size: 15px; font-weight: 500;">
                    <%= product.description || "No product description available." %>
                </p>
            </div>
        </div>
    </div>

    <!-- Related Products Section -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <div class="mt-5 pt-4 border-top">
            <div class="related-title mb-4">
                <h3>Related <span>
                    <% if (product.category_slug === 'smoke') { %>
                        Smoke
                    <% } else if (product.category_slug === 'snacks') { %>
                        Snacks
                    <% } else if (product.category_slug === 'soft-drinks') { %>
                        Soft Drinks
                    <% } else if (product.category_slug === 'spirits') { %>
                        Spirits
                    <% } else { %>
                        <%= product.category_name.toLowerCase().endsWith('s') ? product.category_name : product.category_name + 's' %>
                    <% } %>
                </span></h3>
            </div>
            
            <div class="category-slider-wrap position-relative">
                <button type="button" class="category-slider-arrow category-slider-prev" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <div class="category-products-slider" id="relatedProductsSlider">
                    <% relatedProducts.forEach(prod => { %>
                        <div class="category-product-card">
                            <div class="category-product-image">
                                <% if (prod.is_featured) { %>
                                    <span class="category-product-badge">Popular</span>
                                <% } %>
                                <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(prod.id); %>
                                <button class="category-wishlist wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= prod.id %>">
                                    <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                                <a href="/product/<%= prod.slug %>">
                                    <img src="<%= prod.image || '/images/beer.jpg' %>" alt="<%= prod.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                                </a>
                            </div>
                            <div class="category-product-info">
                                <span class="category-product-category"><%= prod.category_name || product.category_name %></span>
                                <h3>
                                    <a href="/product/<%= prod.slug %>" class="text-decoration-none text-dark">
                                        <%= prod.name %>
                                    </a>
                                </h3>
                                <% if (prod.bottle_size) { %>
                                    <span class="category-product-size"><%= prod.bottle_size %></span>
                                <% } %>
                                <div class="category-product-bottom">
                                    <strong>₹<%= parseInt(prod.price) %></strong>
                                    <% if (prod.sale_price) { %>
                                        <del class="text-muted ms-2" style="font-size: 13px;"><small>₹<%= parseInt(prod.sale_price) %></small></del>
                                    <% } %>
                                    <button class="category-add-btn add-cart-btn" data-product-id="<%= prod.id %>">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <button type="button" class="category-slider-arrow category-slider-next" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    <% } %>

    <!-- Snacks Category Carousel (Shown if current product is NOT a Snack) -->
    <% if (product.category_slug !== 'snacks' && typeof snacks !== 'undefined' && snacks && snacks.length > 0) { %>
        <div class="mt-5 pt-4 border-top">
            <div class="related-title mb-4">
                <h3>Delicious <span>Snacks</span></h3>
            </div>
            
            <div class="category-slider-wrap position-relative">
                <button type="button" class="category-slider-arrow category-slider-prev" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <div class="category-products-slider" id="detailSnacksSlider">
                    <% snacks.forEach(snack => { %>
                        <div class="category-product-card">
                            <div class="category-product-image">
                                <% if (snack.is_featured) { %>
                                    <span class="category-product-badge">Popular</span>
                                <% } %>
                                <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(snack.id); %>
                                <button class="category-wishlist wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= snack.id %>">
                                    <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                                <a href="/product/<%= snack.slug %>">
                                    <img src="<%= snack.image || '/images/beer.jpg' %>" alt="<%= snack.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                                </a>
                            </div>
                            <div class="category-product-info">
                                <span class="category-product-category"><%= snack.category_name || 'Snacks' %></span>
                                <h3>
                                    <a href="/product/<%= snack.slug %>" class="text-decoration-none text-dark">
                                        <%= snack.name %>
                                    </a>
                                </h3>
                                <% if (snack.bottle_size) { %>
                                    <span class="category-product-size"><%= snack.bottle_size %></span>
                                <% } %>
                                <div class="category-product-bottom">
                                    <strong>₹<%= parseInt(snack.price) %></strong>
                                    <% if (snack.sale_price) { %>
                                        <del class="text-muted ms-2" style="font-size: 13px;"><small>₹<%= parseInt(snack.sale_price) %></small></del>
                                    <% } %>
                                    <button class="category-add-btn add-cart-btn" data-product-id="<%= snack.id %>">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <button type="button" class="category-slider-arrow category-slider-next" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    <% } %>

    <!-- Soft Drinks Category Carousel (Shown if current product is NOT a Soft Drink) -->
    <% if (product.category_slug !== 'soft-drinks' && typeof softDrinks !== 'undefined' && softDrinks && softDrinks.length > 0) { %>
        <div class="mt-5 pt-4 border-top">
            <div class="related-title mb-4">
                <h3>Soft <span>Drinks</span></h3>
            </div>
            
            <div class="category-slider-wrap position-relative">
                <button type="button" class="category-slider-arrow category-slider-prev" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <div class="category-products-slider" id="detailSoftDrinksSlider">
                    <% softDrinks.forEach(drink => { %>
                        <div class="category-product-card">
                            <div class="category-product-image">
                                <% if (drink.is_featured) { %>
                                    <span class="category-product-badge">Popular</span>
                                <% } %>
                                <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(drink.id); %>
                                <button class="category-wishlist wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= drink.id %>">
                                    <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                                <a href="/product/<%= drink.slug %>">
                                    <img src="<%= drink.image || '/images/beer.jpg' %>" alt="<%= drink.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                                </a>
                            </div>
                            <div class="category-product-info">
                                <span class="category-product-category"><%= drink.category_name || 'Soft Drinks' %></span>
                                <h3>
                                    <a href="/product/<%= drink.slug %>" class="text-decoration-none text-dark">
                                        <%= drink.name %>
                                    </a>
                                </h3>
                                <% if (drink.bottle_size) { %>
                                    <span class="category-product-size"><%= drink.bottle_size %></span>
                                <% } %>
                                <div class="category-product-bottom">
                                    <strong>₹<%= parseInt(drink.price) %></strong>
                                    <% if (drink.sale_price) { %>
                                        <del class="text-muted ms-2" style="font-size: 13px;"><small>₹<%= parseInt(drink.sale_price) %></small></del>
                                    <% } %>
                                    <button class="category-add-btn add-cart-btn" data-product-id="<%= drink.id %>">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <button type="button" class="category-slider-arrow category-slider-next" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    <% } %>

    <!-- Spirits Category Carousel (Shown if current product is NOT a Spirit) -->
    <% if (product.category_slug !== 'spirits' && typeof spirits !== 'undefined' && spirits && spirits.length > 0) { %>
        <div class="mt-5 pt-4 border-top">
            <div class="related-title mb-4">
                <h3>Premium <span>Spirits</span></h3>
            </div>
            
            <div class="category-slider-wrap position-relative">
                <button type="button" class="category-slider-arrow category-slider-prev" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <div class="category-products-slider" id="detailSpiritsSlider">
                    <% spirits.forEach(spirit => { %>
                        <div class="category-product-card">
                            <div class="category-product-image">
                                <% if (spirit.is_featured) { %>
                                    <span class="category-product-badge">Popular</span>
                                <% } %>
                                <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(spirit.id); %>
                                <button class="category-wishlist wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= spirit.id %>">
                                    <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                                <a href="/product/<%= spirit.slug %>">
                                    <img src="<%= spirit.image || '/images/beer.jpg' %>" alt="<%= spirit.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                                </a>
                            </div>
                            <div class="category-product-info">
                                <span class="category-product-category"><%= spirit.category_name || 'Spirits' %></span>
                                <h3>
                                    <a href="/product/<%= spirit.slug %>" class="text-decoration-none text-dark">
                                        <%= spirit.name %>
                                    </a>
                                </h3>
                                <% if (spirit.bottle_size) { %>
                                    <span class="category-product-size"><%= spirit.bottle_size %></span>
                                <% } %>
                                <div class="category-product-bottom">
                                    <strong>₹<%= parseInt(spirit.price) %></strong>
                                    <% if (spirit.sale_price) { %>
                                        <del class="text-muted ms-2" style="font-size: 13px;"><small>₹<%= parseInt(spirit.sale_price) %></small></del>
                                    <% } %>
                                    <button class="category-add-btn add-cart-btn" data-product-id="<%= spirit.id %>">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <button type="button" class="category-slider-arrow category-slider-next" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    <% } %>

</div>

<%- include('../partials/footer') %>

<!-- Bootstrap Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/js/cart-handler.js"></script>

<script>
$(document).ready(function() {
    // Generic horizontal slider scroll for all sliders
    $(document).on("click", ".category-slider-arrow", function() {
        const arrow = $(this);
        const slider = arrow.siblings(".category-products-slider");
        if (slider.length) {
            const scrollAmount = 450;
            const direction = arrow.hasClass("category-slider-prev") ? -1 : 1;
            slider[0].scrollBy({
                left: direction * scrollAmount,
                behavior: "smooth"
            });
        }
    });
});
</script>
</body>
</html>
