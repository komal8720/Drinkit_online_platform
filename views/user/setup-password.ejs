<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Password - <%= appName %></title>
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/user/home.css">
</head>
<body>

    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>

    <!-- SETUP PASSWORD FORM -->
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                
                <!-- FLASH MESSAGES -->
                <% if (success && success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div id="localAlertContainer"></div>

                <% if (error && error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5" style="border: 1px solid var(--drinkit-border, #e8e4e5) !important;">
                    <div class="text-center mb-4">
                        <span class="logo-icon mb-3 d-inline-flex" style="width: 50px; height: 50px; border-radius: 12px; background: linear-gradient(135deg, var(--drinkit-wine, #731b32), var(--drinkit-wine-dark, #4f1021)); color: #fff; align-items: center; justify-content: center; font-size: 22px;">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        <h2 class="fw-bold" style="color: var(--drinkit-wine, #731b32);">Set Account Password</h2>
                        <p class="text-muted small">Verify your registered email address to set your password</p>
                    </div>

                    <form action="/auth/setup-password" method="POST" id="setupPasswordForm">
                        <!-- Email Address with OTP -->
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold text-secondary">Registered Email Address *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-start-0 border-end-0 ps-0" id="email" name="email" placeholder="Enter your registered email" required>
                                <button class="btn btn-outline-secondary" type="button" id="btnSendOtp" style="border-radius: 0 9px 9px 0; font-weight: 600;">Send OTP</button>
                            </div>
                            <div id="otpStatus" class="form-text mt-1 d-none"></div>
                        </div>

                        <!-- OTP Input Group (Hidden initially) -->
                        <div class="mb-3 d-none" id="otpSection">
                            <label for="otp" class="form-label fw-semibold text-secondary">Enter 6-Digit OTP *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                                <input type="text" class="form-control border-start-0 border-end-0 ps-0" id="otp" placeholder="Enter OTP code" maxlength="6">
                                <button class="btn btn-secondary" type="button" id="btnVerifyOtp" style="border-radius: 0 9px 9px 0; background: var(--drinkit-wine, #731b32); color: white; border: none; font-weight: 600;">Verify OTP</button>
                            </div>
                        </div>

                        <!-- Password + Confirm Password -->
                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold text-secondary">New Password *</label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Min. 6 characters" required>
                        </div>
                        <div class="mb-4">
                            <label for="confirm_password" class="form-label fw-semibold text-secondary">Confirm New Password *</label>
                            <input type="password" class="form-control" id="confirm_password" name="confirm_password" placeholder="Confirm your password" required>
                            <div id="passwordMatchWarning" class="form-text text-danger mt-1 fw-semibold d-none">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Passwords do not match.
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold text-white" id="btnSubmitPassword" disabled style="background: var(--drinkit-muted, #707070); border: none; opacity: 0.65; transition: 0.2s;">
                            Set Password
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0 small">Remember your password? <a href="/auth/login" class="fw-semibold text-decoration-none" style="color: var(--drinkit-wine, #731b32);">Login here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const emailInput = document.getElementById("email");
            const btnSendOtp = document.getElementById("btnSendOtp");
            const otpSection = document.getElementById("otpSection");
            const otpInput = document.getElementById("otp");
            const btnVerifyOtp = document.getElementById("btnVerifyOtp");
            const otpStatus = document.getElementById("otpStatus");
            const localAlertContainer = document.getElementById("localAlertContainer");

            const passwordInput = document.getElementById("password");
            const confirmInput = document.getElementById("confirm_password");
            const warningMsg = document.getElementById("passwordMatchWarning");
            const submitBtn = document.getElementById("btnSubmitPassword");

            let isOtpVerified = false;

            function showLocalAlert(message, type = 'danger') {
                localAlertContainer.innerHTML = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
            }

            function validatePasswords() {
                const pass = passwordInput.value;
                const confirm = confirmInput.value;

                if (confirm.length === 0) {
                    warningMsg.classList.add("d-none");
                    updateSubmitState();
                    return;
                }

                if (pass !== confirm) {
                    warningMsg.classList.remove("d-none");
                } else {
                    warningMsg.classList.add("d-none");
                }
                updateSubmitState();
            }

            passwordInput.addEventListener("input", validatePasswords);
            confirmInput.addEventListener("input", validatePasswords);

            function updateSubmitState() {
                const pass = passwordInput.value;
                const confirm = confirmInput.value;
                const passwordsMatch = pass === confirm && pass.length >= 6;

                if (isOtpVerified && passwordsMatch) {
                    submitBtn.removeAttribute("disabled");
                    submitBtn.style.background = "linear-gradient(135deg, var(--drinkit-wine, #731b32), var(--drinkit-wine-dark, #4f1021))";
                    submitBtn.style.boxShadow = "0 4px 15px rgba(115, 27, 50, 0.22)";
                    submitBtn.style.opacity = "1";
                } else {
                    submitBtn.setAttribute("disabled", "true");
                    submitBtn.style.background = "var(--drinkit-muted, #707070)";
                    submitBtn.style.boxShadow = "none";
                    submitBtn.style.opacity = "0.65";
                }
            }

            btnSendOtp.addEventListener("click", async () => {
                const email = emailInput.value.trim();
                if (!email) {
                    showLocalAlert("Please enter your registered email address.");
                    return;
                }

                btnSendOtp.setAttribute("disabled", "true");
                btnSendOtp.textContent = "Sending...";

                try {
                    const response = await fetch("/auth/send-setup-otp", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email })
                    });
                    const data = await response.json();

                    if (data.success) {
                        showLocalAlert("OTP code sent to your email. Check your inbox.", "success");
                        otpSection.classList.remove("d-none");
                        otpStatus.classList.remove("d-none", "text-danger");
                        otpStatus.classList.add("text-success");
                        otpStatus.textContent = "OTP sent to your email.";
                    } else {
                        showLocalAlert(data.message || "Failed to send OTP.");
                        btnSendOtp.removeAttribute("disabled");
                        btnSendOtp.textContent = "Send OTP";
                    }
                } catch (err) {
                    showLocalAlert("Connection error requesting OTP.");
                    btnSendOtp.removeAttribute("disabled");
                    btnSendOtp.textContent = "Send OTP";
                }
            });

            btnVerifyOtp.addEventListener("click", async () => {
                const email = emailInput.value.trim();
                const otp = otpInput.value.trim();

                if (!otp) {
                    showLocalAlert("Please enter the 6-digit OTP code.");
                    return;
                }

                try {
                    const response = await fetch("/auth/verify-setup-otp", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email, otp })
                    });
                    const data = await response.json();

                    if (data.success) {
                        isOtpVerified = true;
                        showLocalAlert("Email verified! You can now set your password below.", "success");
                        emailInput.setAttribute("readonly", "true");
                        btnSendOtp.setAttribute("disabled", "true");
                        btnSendOtp.textContent = "Verified ✓";
                        otpSection.classList.add("d-none");
                        updateSubmitState();
                    } else {
                        showLocalAlert(data.message || "Invalid OTP code.");
                    }
                } catch (err) {
                    showLocalAlert("Connection error verifying OTP.");
                }
            });
        });
    </script>
</body>
</html>
