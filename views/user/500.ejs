<!DOCTYPE html>
<html lang="<%= typeof langCode !== 'undefined' ? langCode : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : '500 - Server Error' %></title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Home CSS -->
    <link rel="stylesheet" href="/css/user/home.css">
    <style>
        .error-page-container {
            padding: 80px 20px;
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .error-card {
            background: #ffffff;
            border: 1px solid var(--drinkit-border, #e9e4e5);
            border-radius: 20px;
            padding: 50px 40px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.01);
            max-width: 550px;
            text-align: center;
        }
        .error-icon {
            font-size: 72px;
            color: #dc3545; /* error red */
            margin-bottom: 20px;
        }
        .error-card h1 {
            font-size: 28px;
            font-weight: 800;
            color: #292326;
            margin-bottom: 12px;
        }
        .error-card p {
            color: #777174;
            font-size: 14px;
            margin-bottom: 30px;
        }
        .home-btn {
            background: #731b32;
            color: #ffffff;
            font-weight: 700;
            border-radius: 10px;
            padding: 12px 30px;
            border: none;
            text-decoration: none;
            transition: 0.2s;
        }
        .home-btn:hover {
            background: #4d1020;
            color: #ffffff;
        }
    </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container error-page-container">
    <div class="error-card">
        <i class="bi bi-bug-fill error-icon"></i>
        <h1>500 - Server Error</h1>
        <p>Something went wrong on our servers. We are looking into it. Please try reloading the page or head back to the homepage.</p>
        <a href="/" class="home-btn">Go to Homepage</a>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- Bootstrap Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
