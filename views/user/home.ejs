            >

                <div class="category-icon">

                    <i class="bi bi-cup-straw"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Soft Drinks
                    </h3>

                    <span class="category-description">
                        Refreshing beverages
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>

            <!-- ==================================================
                 1. SNACKS
            ================================================== -->

            <a
                href="/products?category=snacks"
                class="category-card category-snacks"
            >

                <div class="category-icon">

                    <i class="bi bi-basket2-fill"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Snacks
                    </h3>

                    <span class="category-description">
                        Chips, nuts & more
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>   

            <!-- ==================================================
                 6. SMOKE
            ================================================== -->

            <a
                href="/products?category=smoke"
                class="category-card category-smoke"
            >

                <div class="category-icon">

                    <i class="bi bi-fire"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Smoke
                    </h3>

                    <span class="category-description">
                        Explore collection
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>


        </div>

    </div>

</section>







<!-- ==========================================================
     POPULAR PRODUCTS
========================================================== -->

<section class="product-section">

    <div class="container">


        <div class="section-heading">

            <div>

                <span class="section-label">
                    CUSTOMER FAVOURITES
                </span>

                <h2>
                    Popular <span>Right Now</span>
                </h2>

            </div>


            <a
                href="/products"
                class="view-all-link"
            >

                Explore All

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="product-grid">
            <% if (typeof popularProducts !== 'undefined' && popularProducts && popularProducts.length > 0) { %>
                <% popularProducts.forEach(product => { %>
                    <div class="product-card revealed">
                        <div class="product-image">
                            <% if (product.is_featured) { %>
                                <span class="product-badge">Popular</span>
                            <% } else if (product.sale_price && product.sale_price > product.price) { %>
                                <% const pct = Math.round(((product.sale_price - product.price) / product.sale_price) * 100); %>
                                <span class="product-badge offer"><%= pct %>% OFF</span>
                            <% } %>
                            <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(product.id); %>
                            <button class="wishlist-btn category-wishlist <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= product.id %>">
                                <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                            </button>
                            <a href="/product/<%= product.slug %>">
                                <img src="<%= product.image || '/images/beer.jpg' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                            </a>
                        </div>
                        <div class="product-info">
                            <span class="product-category"><%= product.category_name || 'Beverage' %></span>
                            <h3>
                                <a href="/product/<%= product.slug %>" class="text-decoration-none text-dark">
                                    <%= product.name %>
                                </a>
                            </h3>
                            <div class="rating">
                                <i class="bi bi-star-fill"></i>
                                <strong>4.8</strong>
                                <span>(124)</span>
                            </div>
                            <div class="product-bottom">
                                <div>
                                    <strong class="product-price">₹<%= parseInt(product.price) %></strong>
                                    <% if (product.sale_price) { %>
                                        <del>₹<%= parseInt(product.sale_price) %></del>
                                    <% } %>
                                </div>
                                <button class="add-cart-btn category-add-btn" data-product-id="<%= product.id %>">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-muted text-center w-100">No popular products found.</p>
            <% } %>
        </div>

    </div>

</section>

<!-- ==========================================================
     CATEGORY PRODUCT SLIDER - ALL PRODUCTS
========================================================== -->

<!-- ==========================================================
     WINE COLLECTION
========================================================== -->
<section class="category-products-section">
    <div class="container">
        <div class="category-products-heading d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="section-eyebrow">CHILL & ENJOY</span>
                <h2>Wine <span>Collection</span></h2>
            </div>
            <a href="/products?category=wine" class="category-see-all">
                See All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="category-slider-wrap">
            <button type="button" class="category-slider-arrow category-slider-prev" aria-label="Previous">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="category-products-slider" id="wineProductsSlider">
                <% if (typeof wine !== 'undefined' && wine && wine.length > 0) { %>
                    <% wine.forEach(product => { %>
                        <div class="category-product-card">
                            <div class="category-product-image">
                                <% if (product.is_featured) { %>
                                    <span class="category-product-badge">Popular</span>
                                <% } %>
                                <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(product.id); %>
                                <button class="category-wishlist wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= product.id %>">
                                    <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                                <a href="/product/<%= product.slug %>">
                                    <img src="<%= product.image || '/images/beer.jpg' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                                </a>
                            </div>
                            <div class="category-product-info">
                                <span class="category-product-category"><%= product.category_name %></span>
                                <h3>
                                    <a href="/product/<%= product.slug %>" class="text-decoration-none text-dark">
                                        <%= product.name %>
                                    </a>
                                </h3>
                                <% if (product.bottle_size) { %>
                                    <span class="category-product-size"><%= product.bottle_size %></span>
                                <% } %>
                                <div class="category-product-bottom">
                                    <strong>₹<%= parseInt(product.price) %></strong>
                                    <% if (product.sale_price) { %>
                                        <del class="text-muted ms-2" style="font-size: 13px;"><small>₹<%= parseInt(product.sale_price) %></small></del>
                                    <% } %>
                                    <button class="category-add-btn add-cart-btn" data-product-id="<%= product.id %>">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-muted p-4">No products available in this collection.</p>
                <% } %>
            </div>

            <button type="button" class="category-slider-arrow category-slider-next" aria-label="Next">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</section>


