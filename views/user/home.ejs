<script>
    // wine slider scroll functionality

    function scrollWineSlider(direction) {

        const slider = document.getElementById("wineProductsSlider");

        const card = slider.querySelector(".category-product-card");

        if (!card) return;

        const cardWidth = card.offsetWidth + 14;

        slider.scrollBy({
            left: direction * cardWidth * 2,
            behavior: "smooth"
        });
    }
    // beer slider scroll functionality
    document.addEventListener("DOMContentLoaded", function () {

        const slider = document.getElementById("beerSlider");

        const nextButton =
            document.querySelector(
                '.category-slider-next[data-slider="beerSlider"]'
            );

        const prevButton =
            document.querySelector(
                '.category-slider-prev[data-slider="beerSlider"]'
            );


        nextButton.addEventListener("click", function () {

            slider.scrollBy({
                left: 450,
                behavior: "smooth"
            });

        });


        prevButton.addEventListener("click", function () {

            slider.scrollBy({
                left: -450,
                behavior: "smooth"
            });

        });

    });


</script>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    
</script>


