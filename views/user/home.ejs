<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Drinkit — Premium Beverages Delivered
    </title>

    <!-- Bootstrap -->

    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Home CSS -->
    <link
        rel="stylesheet"
        href="/css/user/home.css"
    >

</head>


<body>


<!-- ==========================================================
     NAVBAR
========================================================== -->

<%- include('../partials/navbar') %>



<!-- ==========================================================
     HERO SECTION
========================================================== -->

<section class="drinkit-hero">

    <div class="hero-overlay"></div>

    <div class="container">

        <div class="hero-content">

            <span class="hero-eyebrow">

                <i class="bi bi-stars"></i>

                PREMIUM BEVERAGES • FAST DELIVERY

            </span>


            <h1>

                Everything You Love.
                <span>Delivered.</span>

            </h1>


            <p>

                Discover premium wines, refreshing beverages,
                craft drinks and delicious snacks — all in one place.

            </p>


            <div class="hero-buttons">

                <a
                    href="/products"
                    class="hero-primary-btn"
                >

                    Shop Now

                    <i class="bi bi-arrow-right"></i>

                </a>


                <a
                    href="/offers"
                    class="hero-secondary-btn"
                >

                    <i class="bi bi-tag"></i>

                    View Offers

                </a>

            </div>


            <!-- HERO TRUST POINTS -->

            <div class="hero-trust">

                <div>

                    <i class="bi bi-lightning-charge-fill"></i>

                    <span>Fast Delivery</span>

                </div>


                <div>

                    <i class="bi bi-shield-check"></i>

                    <span>Trusted Vendors</span>

                </div>


                <div>

                    <i class="bi bi-box-seam"></i>

                    <span>Secure Packaging</span>

                </div>

            </div>

        </div>

    </div>


    <!-- HERO FEATURE CARD -->

    <div class="hero-product-card">

        <span class="hero-card-label">
            FEATURED
        </span>


        <div class="hero-product-image">

            <img
                src="/images/drinkit-hero.jpg"
                alt="Featured Drink"
            >

        </div>


        <div class="hero-card-content">

            <small>
                PREMIUM COLLECTION
            </small>

            <h3>
                Explore Something Extraordinary
            </h3>

            <a href="/products">
                Explore Collection
                <i class="bi bi-arrow-up-right"></i>
            </a>

        </div>

    </div>

</section>

<!-- ==========================================================
     FILTER BAR
========================================================== -->

<section class="product-filter-section">

    <div class="container">

        <div class="filter-wrapper">


            <div class="filter-title">

                <span>
                    <i class="bi bi-sliders"></i>
                </span>

                <div>

                    <strong>
                        Explore Products
                    </strong>

                    <small>
                        Find exactly what you need
                    </small>

                </div>

            </div>


            <!-- FILTERS -->

            <div class="filter-list">


                <a
                    href="/products"
                    class="filter-pill active"
                >

                    All

                </a>


                <a
                    href="/products?type=alcoholic"
                    class="filter-pill"
                >

                    <i class="bi bi-cup-straw"></i>

                    Alcoholic

                </a>


                <a
                    href="/products?type=non-alcoholic"
                    class="filter-pill"
                >

                    <i class="bi bi-droplet"></i>

                    Non-Alcoholic

                </a>


                <a
                    href="/products?category=snacks"
                    class="filter-pill"
                >

                    <i class="bi bi-basket2"></i>

                    Snacks

                </a>


                <a
                    href="/products?price=500"
                    class="filter-pill"
                >

                    Under ₹500

                </a>


                <a
                    href="/products?offer=true"
                    class="filter-pill filter-offer"
                >

                    <i class="bi bi-lightning-charge-fill"></i>

                    Offers

                </a>


            </div>


            <!-- SORT -->

            <div class="sort-box">

                <label>
                    Sort:
                </label>

                <select
                    onchange="window.location.href=this.value"
                >

                    <option value="/products?sort=popular">
                        Popular
                    </option>

                    <option value="/products?sort=latest">
                        Newest
                    </option>

                    <option value="/products?sort=low">
                        Price: Low to High
                    </option>

                    <option value="/products?sort=high">
                        Price: High to Low
                    </option>

                </select>

                <i class="bi bi-chevron-down"></i>

            </div>

        </div>

    </div>

</section>

<!-- ==========================================================
     QUICK CATEGORIES
========================================================== -->

<!-- ==========================================================
     DRINKIT - SHOP BY CATEGORY
========================================================== -->

<section class="quick-category-section">

    <div class="container">

        <!-- SECTION HEADER -->
        <div class="section-heading">

            <div>

                <span class="section-label">
                    SHOP BY CATEGORY
                </span>

                <h2>
                    What are you <span>looking for?</span>
                </h2>

            </div>


            <a
                href="/products"
                class="view-all-link"
            >
                View All
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>


        <!-- ==================================================
             CATEGORY GRID
        ================================================== -->

        <div class="category-grid">


            <!-- ==================================================
                 1. SNACKS
            ================================================== -->

            <a
                href="/products?category=snacks"
                class="category-card category-snacks"
            >

                <div class="category-icon">

                    <i class="bi bi-basket2-fill"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Snacks
                    </h3>

                    <span class="category-description">
                        Chips, nuts & more
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>



            <!-- ==================================================
                 2. SOFT DRINKS
            ================================================== -->

            <a
                href="/products?category=soft-drinks"
                class="category-card category-soft"
            >

                <div class="category-icon">

                    <i class="bi bi-cup-straw"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Soft Drinks
                    </h3>

                    <span class="category-description">
                        Refreshing beverages
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>



            <!-- ==================================================
                 3. WINE
            ================================================== -->

            <a
                href="/products?category=wine"
                class="category-card category-wine"
            >

                <div class="category-icon">

                    <i class="bi bi-droplet-fill"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Wine
                    </h3>

                    <span class="category-description">
                        Premium collection
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>



            <!-- ==================================================
                 4. BEER
            ================================================== -->

            <a
                href="/products?category=beer"
                class="category-card category-beer"
            >

                <div class="category-icon">

                    <i class="bi bi-cup-fill"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Beer
                    </h3>

                    <span class="category-description">
                        Chill & enjoy
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>



            <!-- ==================================================
                 5. SPIRITS
            ================================================== -->

            <a
                href="/products?category=spirits"
                class="category-card category-spirits"
            >

                <div class="category-icon">

                    <i class="fa-solid fa-wine-bottle"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Spirits
                    </h3>

                    <span class="category-description">
                        Whisky, vodka & more
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>



            <!-- ==================================================
                 6. SMOKE
            ================================================== -->

            <a
                href="/products?category=smoke"
                class="category-card category-smoke"
            >

                <div class="category-icon">

                    <i class="bi bi-fire"></i>

                </div>


                <div class="category-content">

                    <h3>
                        Smoke
                    </h3>

                    <span class="category-description">
                        Explore collection
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>


        </div>

    </div>

</section>







<!-- ==========================================================
     POPULAR PRODUCTS
========================================================== -->

<section class="product-section">

    <div class="container">


        <div class="section-heading">

            <div>

                <span class="section-label">
