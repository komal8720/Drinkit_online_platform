                    <span class="category-description">
                        Chill & enjoy
                    </span>


                    <span class="category-open-btn">
                        Open
                    </span>

                </div>

            </a>



            <!-- ==================================================
                 5. SPIRITS
            ================================================== -->

            <a
                href="/products?category=spirits"
