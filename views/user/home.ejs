    </span>

    <button class="wishlist-btn">
        <i class="bi bi-heart"></i>
    </button>

    <img
        src="/images/snack1.jpg"
        alt="Premium Wine"
    >

</div>


                <div class="product-info">

                    <span class="product-category">
                        Snacks
                    </span>

                    <h3>
                        Premium Crunchy Mix
                    </h3>

                    <div class="rating">

                        <i class="bi bi-star-fill"></i>

                        <strong>4.9</strong>

                        <span>
                            (210)
                        </span>

                    </div>


                    <div class="product-bottom">

                        <div>

                            <strong class="product-price">
                                ₹199
                            </strong>

                            <del>
                                ₹249
                            </del>

                        </div>


                        <button class="add-cart-btn">

                            <i class="bi bi-plus-lg"></i>

                            Add

                        </button>

                    </div>

                </div>

            </div>



            <!-- PRODUCT 4 -->

            <div class="product-card">

              <div class="product-image">

    <span class="product-badge">
        Popular
    </span>

    <button class="wishlist-btn">
        <i class="bi bi-heart"></i>
    </button>

    <img
        src="/images/soft-drink-1.png"
        alt="Premium Wine"
    >

</div>


                <div class="product-info">

                    <span class="product-category">
                        Soft Drinks
                    </span>

                    <h3>
                        Sparkling Refreshment
                    </h3>

                    <div class="rating">

                        <i class="bi bi-star-fill"></i>

                        <strong>4.6</strong>

                        <span>
                            (76)
                        </span>

                    </div>


                    <div class="product-bottom">

                        <div>

                            <strong class="product-price">
                                ₹149
                            </strong>

                            <del>
                                ₹179
                            </del>

                        </div>


                        <button class="add-cart-btn">

                            <i class="bi bi-plus-lg"></i>

                            Add

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- ==========================================================
     DEAL BANNER
========================================================== -->

<section class="deal-section">

    <div class="container">

        <div class="deal-banner">

            <div class="deal-content">

                <span>
                    WEEKEND SPECIAL
                </span>

                <h2>
                    Good Drinks.
                    <br>
                    Better Moments.
                </h2>

                <p>
                    Grab selected beverages and snacks
                    at exclusive prices.
                </p>

                <a href="/offers">
                    Explore Deals
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="deal-icon">

                <i class="bi bi-gift-fill"></i>

            </div>

        </div>

    </div>

</section>



<!-- ==========================================================
     WHY DRINKIT
========================================================== -->

<section class="why-section">

    <div class="container">

        <div class="section-heading centered">

            <span class="section-label">
                WHY DRINKIT
            </span>

            <h2>
                A better way to <span>shop.</span>
            </h2>

        </div>


        <div class="why-grid">


            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>

                <h3>
                    Fast Delivery
                </h3>

                <p>
                    Get your favourite products
                    delivered quickly to your doorstep.
                </p>

            </div>


            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-shop"></i>
                </div>

                <h3>
                    Multiple Vendors
                </h3>

                <p>
                    Discover products from trusted
                    local and premium vendors.
                </p>

            </div>


            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h3>
                    Trusted Shopping
                </h3>

                <p>
                    Secure payments, quality products
                    and reliable service.
                </p>

            </div>


            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-tags-fill"></i>
                </div>

                <h3>
                    Better Offers
                </h3>

                <p>
                    Enjoy exclusive deals and
                    exciting everyday savings.
                </p>

            </div>

        </div>

    </div>

</section>

