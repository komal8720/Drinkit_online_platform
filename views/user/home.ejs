            </div>
            <a href="/products?category=beverages" class="category-see-all">
                See All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="category-slider-wrap">
            <button type="button" class="category-slider-arrow category-slider-prev" aria-label="Previous">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="category-products-slider" id="softDrinksSlider">
                <% if (typeof softDrinks !== 'undefined' && softDrinks && softDrinks.length > 0) { %>
                    <% softDrinks.forEach(product => { %>
                        <div class="category-product-card">
                            <div class="category-product-image">
                                <% if (product.is_featured) { %>
                                    <span class="category-product-badge">Popular</span>
                                <% } %>
                                <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(product.id); %>
                                <button class="category-wishlist wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= product.id %>">
                                    <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                                </button>
                                <a href="/product/<%= product.slug %>">
                                    <img src="<%= product.image || '/images/beer.jpg' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                                </a>
                            </div>
                            <div class="category-product-info">
                                <span class="category-product-category"><%= product.category_name %></span>
                                <h3>
                                    <a href="/product/<%= product.slug %>" class="text-decoration-none text-dark">
                                        <%= product.name %>
                                    </a>
                                </h3>
                                <% if (product.bottle_size) { %>
                                    <span class="category-product-size"><%= product.bottle_size %></span>
                                <% } %>
                                <div class="category-product-bottom">
                                    <strong>₹<%= parseInt(product.price) %></strong>
                                    <% if (product.sale_price) { %>
                                        <del class="text-muted ms-2" style="font-size: 13px;"><small>₹<%= parseInt(product.sale_price) %></small></del>
                                    <% } %>
                                    <button class="category-add-btn add-cart-btn" data-product-id="<%= product.id %>">
                                        ADD
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-muted p-4">No products available in this collection.</p>
                <% } %>
            </div>

            <button type="button" class="category-slider-arrow category-slider-next" aria-label="Next">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</section>


