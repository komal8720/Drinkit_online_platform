<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/js/cart-handler.js"></script>
<script>
$(document).ready(function() {
    // Generic horizontal slider scroll for all sliders
    $(document).on("click", ".category-slider-arrow", function() {
        const arrow = $(this);
        const slider = arrow.siblings(".category-products-slider");
        if (slider.length) {
            const scrollAmount = 450;
            const direction = arrow.hasClass("category-slider-prev") ? -1 : 1;
            slider[0].scrollBy({
                left: direction * scrollAmount,
                behavior: "smooth"
            });
        }
    });
});
</script>

