<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Global CSS -->
    <link rel="stylesheet" href="/css/user/home.css">
    
    <!-- Profile Custom CSS -->
    <link rel="stylesheet" href="/css/user/profile.css">
</head>

<body>

    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>

    <!-- MAIN CONTAINER -->
    <div class="profile-container">
        
        <!-- HEADER -->
        <div class="profile-header">
            <h1>My Profile</h1>
            <p>Manage your personal information and account details.</p>
        </div>

        <!-- FLASH MESSAGES -->
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div id="validationAlertContainer"></div>

        <!-- FORM START -->
        <form action="/profile" method="POST" enctype="multipart/form-data" id="profileForm">
            
            <!-- PROFILE CARD (AVATAR & SUMMARY) -->
            <div class="profile-card d-flex align-items-center profile-card-top">
                <div class="avatar-wrapper">
                    <% if (user.profile_image) { %>
                        <img src="/uploads/<%= user.profile_image %>" alt="Profile Picture" class="profile-avatar" id="avatarPreview">
                    <% } else { %>
                        <div class="profile-avatar" id="avatarPreview">
                            <%= user.first_name ? user.first_name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                    <% } %>
                    <label for="profile_image_input" class="avatar-upload-label" title="Change Photo">
                        <i class="bi bi-camera-fill"></i>
                        <input type="file" name="profile_image" id="profile_image_input" accept="image/*">
                    </label>
                </div>
                
                <div class="user-info-summary">
                    <h3><%= [user.first_name, user.last_name].filter(Boolean).join(" ") %></h3>
                    <p class="mb-1"><i class="bi bi-envelope-fill me-2 text-muted"></i><%= user.email %></p>
                    <p class="mb-2"><i class="bi bi-telephone-fill me-2 text-muted"></i><%= user.mobile || 'No phone added' %></p>
                    <div>
                        <span class="badge">
                            Member since: <%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- PERSONAL INFORMATION & ADDRESS DETAILS -->
            <div class="profile-card">
                
                <!-- Personal Info Section -->
                <div class="section-title">
                    <i class="bi bi-person-fill me-2"></i>Personal Information
                </div>
                
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="first_name" class="form-label">First Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="first_name" name="first_name" value="<%= user.first_name %>" required>
                    </div>
                    <div class="col-md-6">
                        <label for="last_name" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="last_name" name="last_name" value="<%= user.last_name || '' %>">
                    </div>
                    <div class="col-md-6">
                        <label for="email" class="form-label">Email Address (Read-Only)</label>
                        <input type="email" class="form-control" id="email" value="<%= user.email %>" disabled readonly>
                    </div>
                    <div class="col-md-6">
                        <label for="mobile" class="form-label">Phone Number</label>
                        <input type="tel" class="form-control" id="mobile" name="mobile" value="<%= user.mobile || '' %>" placeholder="Enter phone number">
                    </div>
                </div>

                <!-- Address Section -->
                <div class="section-title">
                    <i class="bi bi-geo-alt-fill me-2"></i>Delivery Address Details
                </div>
                
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label for="address_line1" class="form-label">Address Line 1</label>
                        <input type="text" class="form-control" id="address_line1" name="address_line1" value="<%= address ? address.address_line1 : '' %>" placeholder="Apartment, suite, unit, building, street, etc.">
                    </div>
                    <div class="col-12">
                        <label for="address_line2" class="form-label">Address Line 2 (Optional)</label>
                        <input type="text" class="form-control" id="address_line2" name="address_line2" value="<%= address ? address.address_line2 : '' %>" placeholder="Landmark, area, etc.">
                    </div>
                    <div class="col-md-4">
                        <label for="city" class="form-label">City</label>
                        <input type="text" class="form-control" id="city" name="city" value="<%= address ? address.city : '' %>" placeholder="City">
                    </div>
                    <div class="col-md-4">
                        <label for="state" class="form-label">State</label>
                        <input type="text" class="form-control" id="state" name="state" value="<%= address ? address.state : '' %>" placeholder="State">
                    </div>
                    <div class="col-md-4">
                        <label for="pincode" class="form-label">Pincode</label>
                        <input type="text" class="form-control" id="pincode" name="pincode" value="<%= address ? address.pincode : '' %>" placeholder="6-digit pincode" maxlength="6">
                    </div>
                </div>

                <!-- FORM BUTTONS -->
                <div class="d-flex justify-content-end gap-3 btn-actions mt-4">
                    <a href="/" class="btn btn-cancel">Cancel</a>
                    <button type="submit" class="btn btn-save">Save Changes</button>
                </div>

            </div>

        </form>

    </div>

    <!-- FOOTER -->
    <%- include('../partials/footer.ejs') %>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Frontend Image Preview & Validation -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const fileInput = document.getElementById("profile_image_input");
            const avatarPreview = document.getElementById("avatarPreview");
            const profileForm = document.getElementById("profileForm");
            const alertContainer = document.getElementById("validationAlertContainer");

            // 1. Image Preview logic
            fileInput.addEventListener("change", function () {
                const file = this.files[0];
                if (file) {
                    // Check file size (5MB limit)
                    if (file.size > 5 * 1024 * 1024) {
                        showErrorAlert("Image file size should be less than 5MB.");
                        this.value = "";
                        return;
                    }

                    // Check if file type is image
                    if (!file.type.startsWith("image/")) {
                        showErrorAlert("Please select a valid image file.");
                        this.value = "";
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        if (avatarPreview.tagName.toLowerCase() === 'img') {
                            avatarPreview.src = e.target.result;
                        } else {
                            // Replace fallback initial text node with img element
                            const img = document.createElement("img");
                            img.src = e.target.result;
                            img.className = "profile-avatar";
                            img.id = "avatarPreview";
                            avatarPreview.parentNode.replaceChild(img, avatarPreview);
                        }
                    }
                    reader.readAsDataURL(file);
                }
            });

            // 2. Frontend validation on Submit
            profileForm.addEventListener("submit", function (e) {
                const firstName = document.getElementById("first_name").value.trim();
                const mobile = document.getElementById("mobile").value.trim();
                const pincode = document.getElementById("pincode").value.trim();

                let errors = [];

                if (!firstName) {
                    errors.push("First Name is required.");
                }

                if (mobile && !/^\+?[0-9\s\-]{10,15}$/.test(mobile)) {
                    errors.push("Please enter a valid Phone Number (10 to 15 digits).");
                }

                if (pincode && !/^[0-9]{6}$/.test(pincode)) {
                    errors.push("Pincode must be exactly 6 digits.");
                }

                if (errors.length > 0) {
                    e.preventDefault();
                    showErrorAlert(errors.join("<br>"));
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });

            function showErrorAlert(message) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>${message}</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
            }
        });
    </script>
</body>

</html>
