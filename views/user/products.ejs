<!DOCTYPE html>
<html lang="<%= langCode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Home CSS (for grid, product card styles) -->
    <link rel="stylesheet" href="/css/user/home.css">
    <style>
        .products-page-container {
            padding-top: 40px;
            padding-bottom: 80px;
            min-height: 70vh;
        }
        .search-results-header {
            margin-bottom: 30px;
            border-bottom: 1px solid var(--drinkit-border);
            padding-bottom: 20px;
        }
        .search-title h2 {
            font-size: 28px;
            font-weight: 800;
            color: var(--drinkit-text);
        }
        .search-title h2 span {
            color: var(--drinkit-wine);
        }
        .no-results-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid var(--drinkit-border);
            padding: 50px 30px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            max-width: 500px;
            margin: 40px auto;
        }
        .no-results-icon {
            font-size: 64px;
            color: var(--drinkit-wine);
            margin-bottom: 20px;
            opacity: 0.8;
        }
        .no-results-card h3 {
            font-weight: 800;
            color: var(--drinkit-text);
            margin-bottom: 12px;
        }
        .no-results-card p {
            color: var(--drinkit-muted);
            font-size: 14px;
            margin-bottom: 24px;
        }
        .clear-filter-btn {
            background: var(--drinkit-wine);
            color: #ffffff;
            font-weight: 700;
            border-radius: 10px;
            padding: 10px 24px;
            border: none;
            transition: 0.2s;
        }
        .clear-filter-btn:hover {
            background: var(--drinkit-wine-dark);
            color: #ffffff;
        }
        /* Preserve filter list layout adjustments */
        .product-filter-section .filter-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: 50px;
            background: #f7f7f7;
            color: var(--drinkit-text);
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            border: 1px solid transparent;
            transition: 0.22s ease;
        }
        .product-filter-section .filter-pill-btn.active {
            background: var(--drinkit-wine);
            color: #ffffff;
        }
        .product-filter-section .filter-pill-btn:hover:not(.active) {
            background: var(--drinkit-wine-light);
            color: var(--drinkit-wine);
        }
    </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container products-page-container">
    
    <!-- Filter bar -->
    <section class="product-filter-section p-0 mb-4 bg-transparent border-0 shadow-none">
        <div class="filter-wrapper border p-3 bg-white" style="border-radius: 16px;">
            <div class="filter-title">
                <span>
                    <i class="bi bi-sliders"></i>
                </span>
                <div>
                    <strong>Explore Products</strong>
                    <small>Find exactly what you need</small>
                </div>
            </div>
            
            <div class="filter-list">
                <a href="javascript:void(0)" class="filter-pill-btn <%= !categoryFilter ? 'active' : '' %>" data-category="">All</a>
                <% categories.forEach(cat => { %>
                    <a href="javascript:void(0)" class="filter-pill-btn <%= categoryFilter === cat.slug ? 'active' : '' %>" data-category="<%= cat.slug %>">
                        <%= cat.name %>
                    </a>
                <% }) %>
            </div>
            
            <div class="sort-box">
                <label>Sort:</label>
                <select id="productSortSelect">
                    <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Popular</option>
                    <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Newest</option>
                    <option value="low" <%= sort === 'low' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="high" <%= sort === 'high' ? 'selected' : '' %>>Price: High to Low</option>
                </select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>
    </section>

    <!-- Category Filter Details / Title -->
    <div class="search-results-header">
        <div class="search-title">
            <% if (searchQuery) { %>
                <h2><%= __("search_results_for") %>: <span>"<%= searchQuery %>"</span></h2>
                <p class="text-muted"><%= products.length %> items found</p>
            <% } else { %>
                <h2>
                    <% if (categoryFilter) { %>
                        Explore <span><%= categories.find(c => c.slug === categoryFilter)?.name || categoryFilter %></span>
                    <% } else { %>
                        All <span>Products</span>
                    <% } %>
                </h2>
                <p class="text-muted">Showing <%= products.length %> premium items</p>
            <% } %>
        </div>
    </div>

    <!-- Product Grid or Empty State -->
    <% if (products.length > 0) { %>
        <div class="product-grid revealed mt-4">
            <% products.forEach(product => { %>
                <div class="product-card revealed">
                    <div class="product-image">
                        <% if (product.is_featured) { %>
                            <span class="product-badge">Popular</span>
                        <% } %>
                        <button class="wishlist-btn">
                            <i class="bi bi-heart"></i>
                        </button>
                        <img src="<%= product.image || '/images/beer.jpg' %>" alt="<%= product.name %>">
                    </div>
                    <div class="product-info">
                        <span class="product-category"><%= product.category_name || 'Beverage' %></span>
                        <h3><%= product.name %></h3>
                        <% if (product.bottle_size) { %>
                            <small class="text-muted d-block mb-2"><%= product.bottle_size %></small>
                        <% } %>
                        <div class="product-bottom">
                            <div>
                                <strong class="product-price">₹<%= parseInt(product.price) %></strong>
                                <% if (product.sale_price) { %>
                                    <del>₹<%= parseInt(product.sale_price) %></del>
                                <% } %>
                            </div>
                            <button class="add-cart-btn">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="no-results-card">
            <i class="bi bi-search no-results-icon"></i>
            <h3><%= __("no_products_found") %></h3>
            <p>We couldn't find any products matching your query. Try clearing your filters or using different search terms.</p>
            <a href="/products" class="btn clear-filter-btn"><%= __("clear_filters") %></a>
        </div>
    <% } %>

</div>

<%- include('../partials/footer') %>

<!-- Bootstrap Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
$(document).ready(function() {
    // ----------------------------------------------------
    // Dynamic Filter URLs Handler
    // ----------------------------------------------------
    const urlParams = new URLSearchParams(window.location.search);

    // Handle preset category clicks
    $(".filter-pill-btn").on("click", function() {
        const cat = $(this).data("category");
        if (cat) {
            urlParams.set("category", cat);
        } else {
            urlParams.delete("category");
        }
        // Keep search query if preset
        window.location.search = urlParams.toString();
    });

    // Handle sort select change
    $("#productSortSelect").on("change", function() {
        const sortVal = $(this).val();
        urlParams.set("sort", sortVal);
        window.location.search = urlParams.toString();
    });

    // Wishlist Toggle
    $(".wishlist-btn").on("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        const icon = $(this).find("i");
        icon.toggleClass("bi-heart");
        icon.toggleClass("bi-heart-fill");
        $(this).toggleClass("active");
    });
});
</script>
</body>
</html>
