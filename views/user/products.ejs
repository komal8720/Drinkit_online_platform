<!DOCTYPE html>
<html lang="<%= langCode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Home CSS (for grid, product card styles) -->
    <link rel="stylesheet" href="/css/user/home.css">
    <style>
        .products-page-container {
            padding-top: 40px;
            padding-bottom: 80px;
            min-height: 70vh;
        }
        .search-results-header {
            margin-bottom: 30px;
            border-bottom: 1px solid var(--drinkit-border);
            padding-bottom: 20px;
        }
        .search-title h2 {
            font-size: 28px;
            font-weight: 800;
            color: var(--drinkit-text);
        }
        .search-title h2 span {
            color: var(--drinkit-wine);
        }
        .no-results-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid var(--drinkit-border);
            padding: 50px 30px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            max-width: 500px;
            margin: 40px auto;
        }
        .no-results-icon {
            font-size: 64px;
            color: var(--drinkit-wine);
            margin-bottom: 20px;
            opacity: 0.8;
        }
        .no-results-card h3 {
            font-weight: 800;
            color: var(--drinkit-text);
            margin-bottom: 12px;
        }
        .no-results-card p {
            color: var(--drinkit-muted);
            font-size: 14px;
            margin-bottom: 24px;
        }
        .clear-filter-btn {
            background: var(--drinkit-wine);
            color: #ffffff;
            font-weight: 700;
            border-radius: 10px;
            padding: 10px 24px;
            border: none;
            transition: 0.2s;
        }
        .clear-filter-btn:hover {
            background: var(--drinkit-wine-dark);
            color: #ffffff;
        }
        /* Preserve filter list layout adjustments */
        .product-filter-section .filter-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: 50px;
            background: #f7f7f7;
            color: var(--drinkit-text);
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            border: 1px solid transparent;
            transition: 0.22s ease;
        }
        .product-filter-section .filter-pill-btn.active {
            background: var(--drinkit-wine);
            color: #ffffff;
        }
        .product-filter-section .filter-pill-btn:hover:not(.active) {
            background: var(--drinkit-wine-light);
            color: var(--drinkit-wine);
        }

        /* Brand Filter Custom Design */
        .brand-filter-section {
            margin-top: 10px;
            margin-bottom: 30px;
            padding: 15px 0;
            border-top: 1px solid var(--drinkit-border);
        }
        .brand-filter-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--drinkit-muted);
            margin-bottom: 15px;
            display: block;
        }
        .brand-filter-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .brand-filter-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 700;
            background-color: #ffffff;
            color: var(--drinkit-text);
            border: 1px solid var(--drinkit-border);
            cursor: pointer;
            transition: all 0.22s ease-in-out;
            outline: none;
        }
        .brand-filter-btn.active {
            background-color: var(--drinkit-wine);
            color: #ffffff;
            border-color: var(--drinkit-wine);
        }
        .brand-filter-btn:hover:not(.active) {
            border-color: var(--drinkit-wine);
            color: var(--drinkit-wine);
            background-color: var(--drinkit-wine-light);
            transform: scale(1.02);
        }
    </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container products-page-container">
    
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="background: transparent; padding: 0;">
            <li class="breadcrumb-item">
                <a href="/" class="text-decoration-none text-muted" style="font-weight: 600;">
                    <i class="bi bi-house-door-fill me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/products" class="text-decoration-none text-muted" style="font-weight: 600;">Shop</a>
            </li>
            <% if (selectedCategory) { %>
                <li class="breadcrumb-item active text-dark" aria-current="page" style="font-weight: 700;">
                    <%= selectedCategory.name %>
                </li>
            <% } %>
        </ol>
    </nav>
    
    <!-- Filter bar -->
    <section class="product-filter-section p-0 mb-4 bg-transparent border-0 shadow-none">
        <div class="filter-wrapper border p-3 bg-white" style="border-radius: 16px;">
            <div class="filter-title">
                <span>
                    <i class="bi bi-sliders"></i>
                </span>
                <div>
                    <strong>Explore Products</strong>
                    <small>Find exactly what you need</small>
                </div>
            </div>
            
            <div class="filter-list">
                <a href="javascript:void(0)" class="filter-pill-btn <%= !categoryFilter ? 'active' : '' %>" data-category="">All</a>
                <% categories.forEach(cat => { %>
                    <a href="javascript:void(0)" class="filter-pill-btn <%= categoryFilter === cat.slug ? 'active' : '' %>" data-category="<%= cat.slug %>">
                        <%= cat.name %>
                    </a>
                <% }) %>
            </div>
            
            <div class="sort-box">
                <label>Sort:</label>
                <select id="productSortSelect">
                    <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Popular</option>
                    <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Newest</option>
                    <option value="low" <%= sort === 'low' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="high" <%= sort === 'high' ? 'selected' : '' %>>Price: High to Low</option>
                </select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>
    </section>

    <!-- Category Filter Details / Title -->
    <div class="search-results-header">
        <div class="search-title">
            <% if (isInvalidCategory) { %>
                <h2>Category <span>Not Found</span></h2>
                <p class="text-muted">The requested category does not exist.</p>
            <% } else if (searchQuery) { %>
                <h2><%= __("search_results_for") %>: <span>"<%= searchQuery %>"</span></h2>
                <p class="text-muted"><%= totalProducts %> items found</p>
            <% } else { %>
                <h2>
                    <% if (selectedCategory) { %>
                        <%= selectedCategory.name %> <span>Collection</span>
                    <% } else { %>
                        All <span>Products</span>
                    <% } %>
                </h2>
                <% if (selectedCategory && selectedCategory.description) { %>
                    <p class="text-muted"><%= selectedCategory.description %></p>
                <% } else if (selectedCategory) { %>
                    <p class="text-muted">Explore our complete <%= selectedCategory.name.toLowerCase() %> collection.</p>
                <% } else { %>
                    <p class="text-muted">Explore our complete collection of premium beverages and snacks.</p>
                <% } %>
                <p class="text-dark" style="font-size: 14px; font-weight: 700;">Products: <%= totalProducts %></p>
            <% } %>
        </div>
    </div>

    <% if (!isInvalidCategory) { %>
        <!-- Brand Filters (Dynamic based on selected category) -->
        <% if (brands && brands.length > 0) { %>
            <div class="brand-filter-section">
                <span class="brand-filter-title">Filter by Brand</span>
                <div class="brand-filter-list">
                    <button type="button" class="brand-filter-btn <%= !brandFilter ? 'active' : '' %>" data-brand="" aria-pressed="<%= !brandFilter ? 'true' : 'false' %>">
                        All Brands
                    </button>
                    <% brands.forEach(b => { %>
                        <button type="button" class="brand-filter-btn <%= brandFilter === b.slug ? 'active' : '' %>" data-brand="<%= b.slug %>" aria-pressed="<%= brandFilter === b.slug ? 'true' : 'false' %>">
                            <%= b.name %>
                        </button>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <!-- Product Grid or Empty State -->
        <% if (products.length > 0) { %>
            <div class="product-grid revealed mt-4">
                <% products.forEach(product => { %>
                    <div class="product-card revealed">
                        <div class="product-image">
                            <% if (product.is_featured) { %>
                                <span class="product-badge">Popular</span>
                            <% } %>
                            <% const isWishlisted = typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(product.id); %>
                            <button class="wishlist-btn <%= isWishlisted ? 'active' : '' %>" data-product-id="<%= product.id %>">
                                <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                            </button>
                            <a href="/product/<%= product.slug %>">
                                <img src="<%= product.image || '/images/beer.jpg' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/beer.jpg';">
                            </a>
                        </div>
                        <div class="product-info">
                            <span class="product-category"><%= product.category_name || 'Beverage' %></span>
                            <h3>
                                <a href="/product/<%= product.slug %>" class="text-decoration-none text-dark">
                                    <%= product.name %>
                                </a>
                            </h3>
                            <% if (product.bottle_size) { %>
                                <small class="text-muted d-block mb-2"><%= product.bottle_size %></small>
                            <% } %>
                            <div class="product-bottom">
                                <div>
                                    <strong class="product-price">₹<%= parseInt(product.price) %></strong>
                                    <% if (product.sale_price) { %>
                                        <del>₹<%= parseInt(product.sale_price) %></del>
                                    <% } %>
                                </div>
                                <button class="add-cart-btn" data-product-id="<%= product.id %>">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Pagination Grid -->
            <% if (totalPages > 1) { %>
                <nav aria-label="Product Page Navigation" class="mt-5 d-flex justify-content-center">
                    <ul class="pagination">
                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link pagination-link" href="javascript:void(0)" data-page="<%= currentPage - 1 %>">Previous</a>
                        </li>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link pagination-link" href="javascript:void(0)" data-page="<%= i %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link pagination-link" href="javascript:void(0)" data-page="<%= currentPage + 1 %>">Next</a>
                        </li>
                    </ul>
                </nav>
            <% } %>

        <% } else { %>
            <div class="no-results-card">
                <i class="bi bi-search no-results-icon"></i>
                <% if (categoryFilter) { %>
                    <h3>No products available in this category</h3>
                    <p>We are currently updating our stock for this category. Please check back later or browse other items.</p>
                <% } else { %>
                    <h3><%= __("no_products_found") %></h3>
                    <p>We couldn't find any products matching your query. Try clearing your filters or using different search terms.</p>
                <% } %>
                <a href="/products" class="btn clear-filter-btn">Browse All Products</a>
            </div>
        <% } %>
    <% } else { %>
        <!-- Category Not Found -->
        <div class="no-results-card">
            <i class="bi bi-exclamation-circle no-results-icon"></i>
            <h3>Category not found</h3>
            <p>The category you are looking for does not exist or has been disabled.</p>
            <a href="/products" class="btn clear-filter-btn">Browse All Products</a>
        </div>
    <% } %>

</div>

<%- include('../partials/footer') %>

<!-- Bootstrap Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/js/cart-handler.js"></script>
<script>
$(document).ready(function() {
    const urlParams = new URLSearchParams(window.location.search);

    // Handle preset category clicks
    $(".filter-list .filter-pill-btn").on("click", function() {
        const cat = $(this).data("category");
        if (cat) {
            urlParams.set("category", cat);
        } else {
            urlParams.delete("category");
        }
        urlParams.delete("brand"); // Clear brand filter when category changes
        urlParams.delete("page");  // Reset pagination
        window.location.search = urlParams.toString();
    });

    // Handle brand filter clicks
    $(".brand-filter-btn").on("click", function() {
        const brand = $(this).data("brand");
        if (brand) {
            urlParams.set("brand", brand);
        } else {
            urlParams.delete("brand");
        }
        urlParams.delete("page"); // Reset pagination
        window.location.search = urlParams.toString();
    });

    // Handle sort select change
    $("#productSortSelect").on("change", function() {
        const sortVal = $(this).val();
        urlParams.set("sort", sortVal);
        urlParams.delete("page"); // Reset pagination
        window.location.search = urlParams.toString();
    });

    // Handle pagination link clicks
    $(".pagination-link").on("click", function() {
        const page = $(this).data("page");
        if (page) {
            urlParams.set("page", page);
            window.location.search = urlParams.toString();
        }
    });
});
</script>
</body>
</html>
