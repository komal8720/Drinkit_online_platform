<!-- ==========================================================
     DRINKIT — PROFESSIONAL USER NAVBAR
========================================================== -->

<link rel="stylesheet" href="/css/navbar.css">

<nav class="drinkit-main-navbar">

    <div class="drinkit-navbar-inner">

        <!-- ==================================================
             BRAND
        ================================================== -->

        <a href="/" class="drinkit-logo">

            <span class="logo-icon">
                <i class="bi bi-cup-straw"></i>
            </span>

            <span class="logo-text">
                Drink<span>it</span>
            </span>

        </a>


        <!-- ==================================================
             DELIVERY / LOCATION (DYNAMIC MODAL TRIGGER)
        ================================================== -->

        <div class="delivery-info" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#locationModal">

            <div class="delivery-title">
                <%= __("delivery_in") %> <strong><%= __("minutes") %></strong>
            </div>

            <div class="delivery-location">

                <i class="bi bi-geo-alt-fill"></i>

                <span id="navbarLocation"><%= typeof selectedLocation !== 'undefined' ? selectedLocation : "Nagar, Maharashtra" %></span>

                <i class="bi bi-chevron-down location-arrow"></i>

            </div>

        </div>


        <!-- ==================================================
             SEARCH
        ================================================== -->

        <form
            action="/products"
            method="GET"
            class="drinkit-search"
        >
            <% if (typeof categoryFilter !== 'undefined' && categoryFilter) { %>
                <input type="hidden" name="category" value="<%= categoryFilter %>">
            <% } %>
            <% if (typeof brandFilter !== 'undefined' && brandFilter) { %>
                <input type="hidden" name="brand" value="<%= brandFilter %>">
            <% } %>

            <i class="bi bi-search search-icon"></i>

            <input
                type="text"
                name="search"
                id="drinkitSearch"
                placeholder='<%= __("search_placeholder") %>'
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                autocomplete="off"
            >

            <button
                type="submit"
                class="search-button"
            >
                <%= __("search") %>
            </button>

        </form>


        <!-- ==================================================
             RIGHT ACTIONS
        ================================================== -->

        <div class="drinkit-actions">


            <!-- ==============================================
                 LANGUAGE
            =============================================== -->

            <div class="drinkit-language dropdown">

                <button
                    class="language-btn dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                >

                    <i class="bi bi-translate"></i>

                    <span><%= typeof currentLang !== 'undefined' ? currentLang : "EN" %></span>

                </button>


                <ul class="dropdown-menu dropdown-menu-end language-dropdown">

                    <li>

                        <a
                            class="dropdown-item <%= typeof langCode !== 'undefined' && langCode === 'en' ? 'active' : '' %>"
                            href="?lang=en"
                        >

                            <span>
                                English
                            </span>

                            <small>
                                EN
                            </small>

                        </a>

                    </li>


                    <li>

                        <a
                            class="dropdown-item <%= typeof langCode !== 'undefined' && langCode === 'mr' ? 'active' : '' %>"
                            href="?lang=mr"
                        >

                            <span>
                                मराठी
                            </span>

                            <small>
                                MR
                            </small>

                        </a>

                    </li>


                    <li>

                        <a
                            class="dropdown-item <%= typeof langCode !== 'undefined' && langCode === 'hi' ? 'active' : '' %>"
                            href="?lang=hi"
                        >

                            <span>
                                हिन्दी
                            </span>

                            <small>
                                HI
                            </small>

                        </a>

                    </li>

                </ul>

            </div>


            <!-- ==============================================
                 LOGIN / USER
            =============================================== -->

            <% if (typeof user !== 'undefined' && user) { %>

                <!-- ==============================================
                     USER PROFILE DROPDOWN
                =============================================== -->
                <div class="dropdown">

                    <button
                        class="user-profile-btn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >

                        <span class="user-avatar">

                            <i class="bi bi-person-fill"></i>

                        </span>

                        <span class="user-name">
                            <%= [user.first_name, user.last_name].filter(Boolean).join(" ") || "Account" %>
                        </span>

                    </button>


                    <ul class="dropdown-menu dropdown-menu-end drinkit-user-dropdown">


                        <li class="dropdown-user-info">

                            <div class="dropdown-user-avatar">

                                <i class="bi bi-person-fill"></i>

                            </div>

                            <div>

                        <strong>
                            <%= [user.first_name, user.last_name].filter(Boolean).join(" ") || "User" %>
                        </strong>

                                <small>
                                    <%= user.email || "" %>
                                </small>

                            </div>

                        </li>


                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/profile"
                            >

                                <i class="bi bi-person"></i>

                                <%= __("profile") %>

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/orders"
                            >

                                <i class="bi bi-box-seam"></i>

                                <%= __("orders") %>

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/wishlist"
                            >

                                <i class="bi bi-heart"></i>

                                <%= __("wishlist") %>

                            </a>

                        </li>


                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <li>

                            <a
                                class="dropdown-item logout-item"
                                href="/auth/logout"
                            >

                                <i class="bi bi-box-arrow-right"></i>

                                <%= __("logout") %>

                            </a>

                        </li>

                    </ul>

                </div>

                <!-- ==============================================
                     CART
                =============================================== -->
                <a
                    href="/cart"
                    class="drinkit-cart"
                >

                    <span class="cart-icon">

                        <i class="bi bi-bag-fill"></i>

                    </span>


                    <span class="cart-label">
                        <%= __("my_cart") %>
                    </span>


                    <span class="cart-count">
                        <%= typeof cartCount !== 'undefined' ? cartCount : 0 %>
                    </span>

                </a>


            <% } else { %>


                <!-- LOGIN -->
                <a
                    href="/auth/login"
                    class="drinkit-login"
                >

                    <i class="bi bi-person"></i>

                    <span><%= __("login") %></span>

                </a>

                <!-- REGISTER -->
                <a
                    href="/auth/register"
                    class="drinkit-login"
                    style="border: 1px solid var(--drinkit-border);"
                >

                    <i class="bi bi-person-plus"></i>

                    <span><%= __("register") %></span>

                </a>


            <% } %>


        </div>

    </div>

</nav>


<!-- ==========================================================
     LOCATION SELECTOR MODAL
========================================================== -->
<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header" style="border-bottom: 1px solid var(--drinkit-border); padding: 20px 24px;">
                <h5 class="modal-title" id="locationModalLabel" style="font-weight: 800; color: var(--drinkit-wine);"><%= __("select_location_title") %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <!-- Current Location Display -->
                <div class="mb-4">
                    <small class="text-muted d-block mb-1" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Current Selected Location</small>
                    <div class="d-flex align-items-center gap-2 p-3" style="background: var(--drinkit-wine-light); border-radius: 12px; border: 1px solid rgba(115, 27, 50, 0.1);">
                        <i class="bi bi-geo-alt-fill" style="color: var(--drinkit-wine); font-size: 18px;"></i>
                        <strong style="color: var(--drinkit-wine-dark);" id="currentLocationDisplay"><%= typeof selectedLocation !== 'undefined' ? selectedLocation : "Nagar, Maharashtra" %></strong>
                    </div>
                </div>

                <!-- Geolocation Button -->
                <button type="button" class="btn w-100 mb-4 d-flex align-items-center justify-content-center gap-2" id="useGeolocationBtn" style="height: 48px; border-radius: 12px; font-weight: 700; border: 1px solid var(--drinkit-wine); color: var(--drinkit-wine); background: #ffffff; transition: 0.2s;">
                    <i class="bi bi-crosshair"></i>
                    <span><%= __("use_current_location") %></span>
                </button>

                <!-- Popular Locations Grid -->
                <div class="mb-4">
                    <small class="text-muted d-block mb-2" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Popular Cities</small>
                    <div class="row g-2">
                        <% ["Nagar, Maharashtra", "Pune, Maharashtra", "Mumbai, Maharashtra", "Thane, Maharashtra", "Nashik, Maharashtra", "Aurangabad, Maharashtra"].forEach(loc => { %>
                            <div class="col-6">
                                <button type="button" class="btn w-100 preset-location-btn text-start text-truncate" data-location="<%= loc %>" style="padding: 10px 12px; font-size: 13px; font-weight: 600; border: 1px solid var(--drinkit-border); border-radius: 10px; background: #ffffff; color: var(--drinkit-text); transition: 0.2s;">
                                    📍 <%= loc.split(",")[0] %>
                                </button>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- Manual Input -->
                <div>
                    <small class="text-muted d-block mb-2" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;"><%= __("enter_location_placeholder") %></small>
                    <div class="d-flex gap-2">
                        <input type="text" id="manualLocationInput" class="form-control" placeholder="Type city or area..." style="height: 44px; border-radius: 10px; font-size: 14px; border-color: var(--drinkit-border);">
                        <button type="button" id="saveManualLocationBtn" class="btn" style="background: var(--drinkit-wine); color: #ffffff; font-weight: 700; border-radius: 10px; padding: 0 20px;"><%= __("save") %></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ==========================================================
     NAVBAR SCRIPTING
========================================================== -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    // ----------------------------------------------------
    // Location selector logic
    // ----------------------------------------------------
    const locationModal = document.getElementById("locationModal");
    const navbarLocation = document.getElementById("navbarLocation");
    const currentLocationDisplay = document.getElementById("currentLocationDisplay");
    const useGeolocationBtn = document.getElementById("useGeolocationBtn");
    const manualLocationInput = document.getElementById("manualLocationInput");
    const saveManualLocationBtn = document.getElementById("saveManualLocationBtn");
    const presetButtons = document.querySelectorAll(".preset-location-btn");

    function updateLocationOnServer(locName) {
        fetch("/set-location", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ location: locName })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Update elements in navbar and modal
                if (navbarLocation) navbarLocation.textContent = data.location;
                if (currentLocationDisplay) currentLocationDisplay.textContent = data.location;
                
                // Hide modal
                const modalInstance = bootstrap.Modal.getInstance(locationModal);
                if (modalInstance) {
                    modalInstance.hide();
                }
                
                // Reload page to reflect updated location
                window.location.reload();
            }
        })
        .catch(err => console.error("Error setting location:", err));
    }

    // Handle preset locations
    presetButtons.forEach(btn => {
        btn.addEventListener("click", function () {
            const loc = this.getAttribute("data-location");
            updateLocationOnServer(loc);
        });
    });

    // Handle manual input
    if (saveManualLocationBtn) {
        saveManualLocationBtn.addEventListener("click", function () {
            const val = manualLocationInput.value.trim();
            if (val) {
                updateLocationOnServer(val);
            }
        });
    }

    // Handle manual input Enter press
    if (manualLocationInput) {
        manualLocationInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                const val = manualLocationInput.value.trim();
                if (val) {
                    updateLocationOnServer(val);
                }
            }
        });
    }

    // Handle Geolocation API
    if (useGeolocationBtn) {
        useGeolocationBtn.addEventListener("click", function () {
            useGeolocationBtn.disabled = true;
            useGeolocationBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Locating...';

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        const lat = position.coords.latitude;
                        const lon = position.coords.longitude;

                        // Call Nominatim API for reverse geocoding
                        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=10`)
                            .then(res => res.json())
                            .then(data => {
                                let addressName = "Nagar, Maharashtra";
                                if (data && data.address) {
                                    const city = data.address.city || data.address.town || data.address.village || data.address.suburb || data.address.county || "";
                                    const state = data.address.state || "";
                                    if (city && state) {
                                        addressName = `${city}, ${state}`;
                                    } else if (city) {
                                        addressName = city;
                                    } else if (state) {
                                        addressName = state;
                                    }
                                }
                                updateLocationOnServer(addressName);
                            })
                            .catch(err => {
                                console.error("Geocoding failed:", err);
                                // Fallback if lookup fails
                                updateLocationOnServer("Nagar, Maharashtra");
                            })
                            .finally(() => {
                                useGeolocationBtn.disabled = false;
                                useGeolocationBtn.innerHTML = '<i class="bi bi-crosshair"></i> Use my current location';
                            });
                    },
                    function (error) {
                        console.error("Geolocation error:", error);
                        alert("Could not retrieve geolocation. Please select a city manually.");
                        useGeolocationBtn.disabled = false;
                        useGeolocationBtn.innerHTML = '<i class="bi bi-crosshair"></i> Use my current location';
                    }
                );
            } else {
                alert("Geolocation is not supported by your browser.");
                useGeolocationBtn.disabled = false;
                useGeolocationBtn.innerHTML = '<i class="bi bi-crosshair"></i> Use my current location';
            }
        });
    }
    
    // ----------------------------------------------------
    // Language dropdown URL parameter preservation
    // ----------------------------------------------------
    document.querySelectorAll('.language-dropdown a').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const urlParams = new URLSearchParams(window.location.search);
            const hrefLang = this.getAttribute('href');
            const targetLang = hrefLang.split('lang=')[1];
            urlParams.set('lang', targetLang);
            window.location.search = urlParams.toString();
        });
    });
});
</script>